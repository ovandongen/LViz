<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LViz.App.ViewModels"
        xmlns:svc="using:LViz.App.Services"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="LViz.App.Views.IconPickerDialog"
        x:DataType="vm:IconPickerViewModel"
        Title="{Binding [IconPicker_Title], Source={StaticResource Loc}}"
        Width="640" Height="560"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}">

    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
            <TextBox Watermark="{Binding [IconPicker_SearchWatermark], Source={StaticResource Loc}}"
                     Text="{Binding Query, Mode=TwoWay}"
                     x:Name="SearchBox" />
            <TextBlock Foreground="{StaticResource TextSubtle}" FontSize="11"
                       Text="{Binding CountText}" />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSubtle}" FontSize="11"
                       Text="{Binding SelectedText}" />
            <Button Grid.Column="1"
                    Content="{Binding [IconPicker_ClearIcon], Source={StaticResource Loc}}"
                    Margin="0,0,8,0"
                    Click="OnClearClick" />
            <Button Grid.Column="2"
                    Content="{Binding [IconPicker_Cancel], Source={StaticResource Loc}}"
                    Click="OnCancelClick" />
        </Grid>

        <ListBox ItemsSource="{Binding Rows}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:FontAwesomeCatalog+Entry">
                                <Button Width="72" Height="72" Margin="2"
                                        Background="{StaticResource BgSurface0}"
                                        BorderBrush="{StaticResource BgSurface1}"
                                        BorderThickness="1"
                                        Padding="4"
                                        ToolTip.Tip="{Binding Name}"
                                        Click="OnIconButtonClick"
                                        Tag="{Binding Name}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                        <i:Icon Value="{Binding Name}"
                                                FontSize="24"
                                                Foreground="{StaticResource Text}"
                                                HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="8"
                                                   Foreground="{StaticResource TextSubtle}"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="64" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</Window>
