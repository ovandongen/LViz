<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LViz.App.ViewModels"
        x:Class="LViz.App.Views.KeymapReviewDialog"
        x:DataType="vm:KeymapReviewDialogViewModel"
        Title="{Binding [Edit_ReviewTitle], Source={StaticResource Loc}}"
        Width="520" Height="440"
        CanResize="True"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}">

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top"
                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                   TextWrapping="Wrap"
                   Text="{Binding HeaderText}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{Binding [Edit_Cancel], Source={StaticResource Loc}}"
                    Click="OnCancelClick" />
            <Button Content="{Binding [Edit_Save], Source={StaticResource Loc}}"
                    Classes="accent"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,12,0,0"
                    IsVisible="{Binding HasCommitMessage}">
            <TextBlock Text="{Binding [Edit_ReviewCommitMessage], Source={StaticResource Loc}}"
                       FontSize="11" Foreground="{StaticResource TextSubtle}" />
            <TextBox Text="{Binding CommitMessage, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="110"
                     FontFamily="Menlo, Consolas, monospace" />
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock FontSize="12" Foreground="{StaticResource Text}"
                                   TextWrapping="Wrap" Margin="0,2" Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</Window>
