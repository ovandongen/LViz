<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LViz.App.ViewModels"
             xmlns:sys="using:System"
             xmlns:conv="using:LViz.App.Converters"
             xmlns:avconv="using:Avalonia.Data.Converters"
             x:Class="LViz.App.Views.ComboLegendView"
             x:Name="Legend"
             x:DataType="vm:ComboLegendViewModel">

    <UserControl.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <DockPanel>
        <Button DockPanel.Dock="Left"
                Command="{Binding Edit.NewComboCommand}"
                IsVisible="{Binding IsEditing}"
                Focusable="False"
                Padding="8,4"
                Margin="0,0,2,0"
                VerticalAlignment="Top"
                ToolTip.Tip="{Binding [Tooltip_NewCombo], Source={StaticResource Loc}}">
            <TextBlock Text="+" FontSize="14" />
        </Button>
        <Grid>
            <TextBlock Text="{Binding [ComboLegend_Empty], Source={StaticResource Loc}}"
                   HorizontalAlignment="Center"
                   Opacity="0.65"
                   Margin="0,4"
                   Foreground="{StaticResource Text}">
                <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static conv:EqualityToBoolMultiConverter.Instance}">
                        <Binding Path="Combos.Count" />
                        <Binding>
                            <Binding.Source>
                                <sys:Int32>0</sys:Int32>
                            </Binding.Source>
                        </Binding>
                    </MultiBinding>
                </TextBlock.IsVisible>
            </TextBlock>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="160">
                <ItemsControl ItemsSource="{Binding Combos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <!-- Background/BorderBrush are per-combo (data-bound
                             to ComboColorPalette via Color/DarkColor on the
                             VM). Default fill is the light pastel + dark
                             text; hover/active swap to the darkened sibling
                             + light text, mirroring the on-key pill. -->
                        <Style Selector="Button.comboTile">
                            <Setter Property="Background" Value="{StaticResource ComboFill}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ComboStroke}" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Padding" Value="10,5" />
                            <Setter Property="Margin" Value="0,0,6,6" />
                            <Setter Property="MinWidth" Value="56" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="Button.comboTile TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource BgBase}" />
                        </Style>
                        <Style Selector="Button.comboTile:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource ComboStroke}" />
                            <Setter Property="BorderBrush" Value="{Binding DataContext.BoardStyle.PressHighlightColor, ElementName=Legend, Converter={StaticResource HexToBrush}}" />
                        </Style>
                        <Style Selector="Button.comboTile:pointerover TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Style>
                        <Style Selector="Button.comboTile.active /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource ComboStroke}" />
                            <Setter Property="BorderBrush" Value="{Binding DataContext.BoardStyle.PressHighlightColor, ElementName=Legend, Converter={StaticResource HexToBrush}}" />
                        </Style>
                        <Style Selector="Button.comboTile.active TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Style>
                        <!-- Pending-change mark (edit mode): a yellow border,
                             the board's changed-key colour. Declared last so
                             it outranks the hover/active BorderBrush — the
                             mark never blinks off under the pointer. -->
                        <Style Selector="Button.comboTile.changed /template/ ContentPresenter">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentYellow}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComboViewModel">
                            <Button Classes="comboTile"
                                Classes.active="{Binding IsHighlighted}"
                                Classes.changed="{Binding IsChanged}"
                                Focusable="False"
                                PointerEntered="OnComboTilePointerEntered"
                                PointerExited="OnComboTilePointerExited"
                                PointerPressed="OnComboTilePointerPressed"
                                DoubleTapped="OnComboTileDoubleTapped"
                                ToolTip.Tip="{Binding ParticipatingKeysText}">
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Number}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Top"
                                           Opacity="0.85" />
                                    <TextBlock Text="{Binding Label}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Subscript}"
                                           FontSize="11"
                                           VerticalAlignment="Bottom"
                                           Opacity="0.85"
                                           IsVisible="{Binding Subscript, Converter={x:Static avconv:StringConverters.IsNotNullOrEmpty}}" />
                                    <!-- Edit-mode actions: edit/delete live on
                                         the edit VM, addressed through
                                         Legend (the tile's own DataContext is
                                         the combo). A press here never reaches
                                         the tile's single/right-click paths
                                         with an editor side effect. -->
                                    <Button IsVisible="{Binding IsEditable}"
                                        Focusable="False"
                                        Padding="4,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding [Tooltip_ComboMenu], Source={StaticResource Loc}}">
                                        <TextBlock Text="⋮" FontSize="12" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuItem Header="{Binding [Edit_ComboMenuEdit], Source={StaticResource Loc}}"
                                                      Command="{Binding DataContext.Edit.EditComboCommand, ElementName=Legend}"
                                                      CommandParameter="{Binding Number}" />
                                                <MenuItem Header="{Binding [Edit_ComboMenuDelete], Source={StaticResource Loc}}"
                                                      Command="{Binding DataContext.Edit.DeleteComboCommand, ElementName=Legend}"
                                                      CommandParameter="{Binding Number}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
