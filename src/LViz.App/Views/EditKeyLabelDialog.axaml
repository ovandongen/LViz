<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LViz.App.ViewModels"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="LViz.App.Views.EditKeyLabelDialog"
        x:DataType="vm:EditKeyLabelDialogViewModel"
        Title="{Binding [EditKey_Title], Source={StaticResource Loc}}"
        Width="420" Height="460"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}">

    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                       Text="{Binding LayerKeyHeader}" />
            <TextBlock FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextSubtle}"
                       TextWrapping="Wrap"
                       Text="{Binding DefaultHintLine}" />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0"
                    Content="{Binding [EditKey_ClearOverride], Source={StaticResource Loc}}"
                    IsEnabled="{Binding HasExistingOverride}"
                    Click="OnClearOverrideClick" />
            <Button Grid.Column="2"
                    Content="{Binding [EditKey_Cancel], Source={StaticResource Loc}}"
                    Margin="8,0,0,0"
                    Click="OnCancelClick" />
            <Button Grid.Column="3"
                    Content="{Binding [EditKey_Save], Source={StaticResource Loc}}"
                    Margin="8,0,0,0"
                    Classes="accent"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </Grid>

        <StackPanel Spacing="10">

            <StackPanel Spacing="2">
                <TextBlock Text="{Binding [EditKey_MainLabel], Source={StaticResource Loc}}"
                           FontSize="11" Foreground="{StaticResource TextSubtle}" />
                <TextBox Text="{Binding MainLabel, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="{Binding [EditKey_Subscript], Source={StaticResource Loc}}"
                           FontSize="11" Foreground="{StaticResource TextSubtle}" />
                <TextBox Text="{Binding Subscript, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="{Binding [EditKey_TopLeftBadge], Source={StaticResource Loc}}"
                           FontSize="11" Foreground="{StaticResource TextSubtle}" />
                <TextBox Text="{Binding TopLeftBadge, Mode=TwoWay}" />
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                           Text="{Binding [EditKey_Icon], Source={StaticResource Loc}}"
                           FontSize="11" Foreground="{StaticResource TextSubtle}" />
                <Border Grid.Row="1" Grid.Column="0"
                        Width="36" Height="36"
                        Background="{StaticResource BgSurface0}" CornerRadius="4"
                        Margin="0,2,8,0">
                    <i:Icon Value="{Binding Icon}"
                            FontSize="20"
                            Foreground="{StaticResource Text}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding Icon}" FontSize="12" Foreground="{StaticResource Text}"
                           VerticalAlignment="Center" Margin="0,2,8,0" />
                <Button Grid.Row="1" Grid.Column="2"
                        Content="{Binding [EditKey_Pick], Source={StaticResource Loc}}"
                        Margin="0,2,4,0"
                        Click="OnPickIconClick" />
                <Button Grid.Row="1" Grid.Column="3"
                        Content="{Binding [EditKey_Clear], Source={StaticResource Loc}}"
                        Margin="0,2,0,0"
                        Click="OnClearIconClick"
                        IsEnabled="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding [EditKey_FontSize], Source={StaticResource Loc}}"
                               FontSize="11" Foreground="{StaticResource TextSubtle}" />
                    <NumericUpDown Value="{Binding FontSize, Mode=TwoWay}"
                                   Minimum="6" Maximum="48"
                                   Increment="1" FormatString="0"
                                   HorizontalAlignment="Left" Width="120" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding [EditKey_Reset], Source={StaticResource Loc}}"
                        VerticalAlignment="Bottom" Margin="8,0,0,0"
                        Click="OnResetFontSizeClick" />
                <CheckBox Grid.Column="2"
                          Content="{Binding [EditKey_Bold], Source={StaticResource Loc}}"
                          Margin="16,0,0,0"
                          VerticalAlignment="Bottom"
                          IsChecked="{Binding Bold, Mode=TwoWay}" />
            </Grid>

        </StackPanel>
    </DockPanel>

</Window>
