<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LViz.App.ViewModels"
        xmlns:views="using:LViz.App.Views"
        xmlns:sys="using:System"
        xmlns:conv="using:LViz.App.Converters"
        xmlns:avconv="using:Avalonia.Data.Converters"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="LViz.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="MainWin"
        Title="{Binding [Title_App], Source={StaticResource Loc}}"
        Width="1440" Height="680"
        MinWidth="640" MinHeight="320"
        TransparencyLevelHint="Transparent,AcrylicBlur,None"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        SystemDecorations="None"
        Topmost="{Binding Preferences.IsAlwaysOnTop}">

    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>

    <Window.Styles>
        <!-- Shared toggle-button style: dim when off, fully opaque when .active. -->
        <Style Selector="Button.toggle">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.toggle.active">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Bars panel: Row 0 (top) or Row 2 (bottom), switched automatically.
             Inner Grid swaps StatusBar/EditBanner/LayerTabs/ComboLegend so the
             status bar is always at the outer edge and the combo legend always
             sits closest to the keyboard. -->
        <Grid x:Name="BarsPanel" Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto">

            <!-- Status bar (solid, also serves as drag handle) -->
            <Border x:Name="StatusBar" Grid.Row="0" Background="{StaticResource BgBase}" Padding="12,8"
                    CornerRadius="8,8,0,0">
                <DockPanel>
                    <Button x:Name="QuitButton" DockPanel.Dock="Left"
                            Command="{Binding QuitCommand}"
                            Focusable="False"
                            Padding="6,4" Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding [Tooltip_Quit], Source={StaticResource Loc}}">
                        <PathIcon Width="12" Height="12"
                                  Data="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12 5.7 16.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4z" />
                    </Button>
                    <Button x:Name="MinimizeButton"
                            DockPanel.Dock="Left"
                            Focusable="False"
                            Padding="6,4" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding [Tooltip_Minimize], Source={StaticResource Loc}}">
                        <PathIcon Width="12" Height="12"
                                  Data="M20 14H4v-2h16v2z" />
                    </Button>

                    <!-- Primary controls: keyboard picker, load JSON, info hover, keymap edit.
                         Sit just after the chrome buttons. -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel.Styles>
                            <Style Selector="StackPanel > Button">
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </StackPanel.Styles>

                        <!-- Keyboard profile picker — switches the physical layout (GO60 / Glove80). -->
                        <Button x:Name="KeyboardPickerButton"
                                Padding="8,4"
                                IsEnabled="{Binding !IsEditing}"
                                ToolTip.Tip="{Binding [Tooltip_Keyboard], Source={StaticResource Loc}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Width="14" Height="14"
                                          Data="M20 5H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-9 3h2v2h-2V8zm0 3h2v2h-2v-2zM8 8h2v2H8V8zm0 3h2v2H8v-2zm-1 2H5v-2h2v2zm0-3H5V8h2v2zm9 7H8v-2h8v2zm0-4h-2v-2h2v2zm0-3h-2V8h2v2zm3 3h-2v-2h2v2zm0-3h-2V8h2v2z" />
                                <TextBlock Text="{Binding SelectedKeyboard.DisplayName}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding AvailableKeyboards}" Padding="2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectKeyboardCommand, ElementName=MainWin}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,6"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent">
                                                        <Grid ColumnDefinitions="16,*">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="✓"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="Bold">
                                                                <TextBlock.IsVisible>
                                                                    <MultiBinding Converter="{x:Static conv:EqualityToBoolMultiConverter.Instance}">
                                                                        <Binding Path="Id" />
                                                                        <Binding Path="DataContext.SelectedKeyboard.Id" ElementName="MainWin" />
                                                                    </MultiBinding>
                                                                </TextBlock.IsVisible>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1"
                                                                       VerticalAlignment="Center">
                                                                <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                                                <Run Text=" — " Foreground="{StaticResource TextStatusBar}" />
                                                                <Run Text="{Binding KeyCount, Mode=OneWay}" Foreground="{StaticResource TextStatusBar}" />
                                                                <Run Text=" keys" Foreground="{StaticResource TextStatusBar}" />
                                                            </TextBlock>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Separator Margin="2,4" />
                                        <!-- Wizard entry point for boards with no bundled layout.
                                             Hide is posted, not immediate — the button reads its
                                             Command only after Click returns (see OnKeymapMenuItemClick). -->
                                        <Button x:Name="AddOwnBoardButton"
                                                Click="OnAddOwnBoardClick"
                                                Command="{Binding DataContext.AddOwnBoardCommand, ElementName=MainWin}"
                                                Padding="10,6"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                Content="{Binding [Picker_AddOwnBoard], Source={StaticResource Loc}}" />
                                        <!-- Same treatment for editing the layout already in use;
                                             only shown when a user layout is the active board. -->
                                        <Button x:Name="EditLayoutButton"
                                                Click="OnEditLayoutClick"
                                                Command="{Binding DataContext.EditLayoutCommand, ElementName=MainWin}"
                                                Padding="10,6"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                IsVisible="{Binding DataContext.CanEditLayout, ElementName=MainWin}"
                                                Content="{Binding [Picker_EditLayout], Source={StaticResource Loc}}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Load layout JSON — opens a flyout: Browse… + recent keymaps. -->
                        <Button x:Name="LoadLayoutButton"
                                Padding="8,4"
                                IsEnabled="{Binding !IsEditing}"
                                ToolTip.Tip="{Binding [Tooltip_LoadLayout], Source={StaticResource Loc}}">
                            <PathIcon Width="14" Height="14"
                                      Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                            <Button.Flyout>
                                <!-- Opened → refresh the Exists flags so a file that vanished
                                     since the last open greys out before the list is shown.
                                     MinWidth keeps the flyout roomy for typical names, MaxWidth
                                     makes long folders trim instead of stretching it. -->
                                <Flyout Placement="Bottom" Opened="OnRecentKeymapsFlyoutOpened">
                                    <Border Padding="2" MinWidth="280" MaxWidth="384">
                                        <StackPanel>
                                            <Button Command="{Binding LoadLayoutCommand}"
                                                    Click="OnKeymapMenuItemClick"
                                                    Padding="10,6"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Background="Transparent"
                                                    ToolTip.Tip="{Binding [Tooltip_LoadLayout], Source={StaticResource Loc}}">
                                                <TextBlock Text="{Binding [RecentKeymaps_Browse], Source={StaticResource Loc}}"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                            <Button Command="{Binding OpenFromGitHubCommand}"
                                                    Click="OnKeymapMenuItemClick"
                                                    Padding="10,6"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Background="Transparent">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <i:Icon Value="fa-brands fa-github" FontSize="12"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding [RecentKeymaps_OpenFromGitHub], Source={StaticResource Loc}}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <Separator Margin="4,2" />

                                            <!-- Recent keymaps of the active profile. Rows mirror the
                                                 keyboard picker: ✓ column + stretched transparent
                                                 button. Stale rows (Exists=false) grey out and swap
                                                 the folder line for "File not found"; clicking one
                                                 prunes it (command decides load vs prune). -->
                                            <ItemsControl ItemsSource="{Binding Recents.Items}"
                                                          IsVisible="{Binding Recents.HasAny}">
                                                <ItemsControl.Styles>
                                                    <Style Selector="Button.missing">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </Style>
                                                </ItemsControl.Styles>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Classes.missing="{Binding !Exists}"
                                                                Command="{Binding DataContext.Recents.OpenCommand, ElementName=MainWin}"
                                                                CommandParameter="{Binding}"
                                                                Click="OnKeymapMenuItemClick"
                                                                Padding="10,6"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Background="Transparent"
                                                                ToolTip.Tip="{Binding Path}">
                                                            <Grid ColumnDefinitions="16,*">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="✓"
                                                                           IsVisible="{Binding IsCurrent}"
                                                                           VerticalAlignment="Center"
                                                                           FontWeight="Bold" />
                                                                <StackPanel Grid.Column="1" Spacing="1">
                                                                    <!-- DockPanel, not a horizontal StackPanel: the
                                                                         latter measures unbounded, so the name never trims. -->
                                                                    <DockPanel>
                                                                        <i:Icon DockPanel.Dock="Left"
                                                                                Value="fa-brands fa-github" FontSize="11"
                                                                                Margin="0,0,4,0"
                                                                                VerticalAlignment="Center"
                                                                                IsVisible="{Binding IsGitHub}" />
                                                                        <TextBlock Text="{Binding FileName}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding Folder}"
                                                                               Foreground="{StaticResource TextStatusBar}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               IsVisible="{Binding Exists}" />
                                                                    <TextBlock Text="{Binding [RecentKeymaps_Missing], Source={StaticResource Loc}}"
                                                                               Foreground="{StaticResource TextStatusBar}"
                                                                               IsVisible="{Binding !Exists}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Emptiness line: a label, not a row — nothing to click. -->
                                            <TextBlock Text="{Binding [RecentKeymaps_Empty], Source={StaticResource Loc}}"
                                                       IsVisible="{Binding !Recents.HasAny}"
                                                       Padding="10,6"
                                                       Foreground="{StaticResource TextStatusBar}" />

                                            <Separator Margin="4,2"
                                                       IsVisible="{Binding Recents.HasAny}" />
                                            <Button Command="{Binding Recents.ClearCommand}"
                                                    Click="OnKeymapMenuItemClick"
                                                    IsVisible="{Binding Recents.HasAny}"
                                                    Padding="10,6"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Background="Transparent">
                                                <TextBlock Text="{Binding [RecentKeymaps_Clear], Source={StaticResource Loc}}"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Loaded-layout info: icon-only, hover tooltip shows full "Loaded foo.json (N layers) · keyboard hint". -->
                        <Button x:Name="InfoButton"
                                Padding="8,4"
                                ToolTip.Tip="{Binding LoadInfoTooltip}">
                            <PathIcon Width="14" Height="14"
                                      Data="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" />
                        </Button>

                        <!-- Keymap edit — opens edit mode (banner + key picking).
                             Disabled states explain themselves via the tooltip. -->
                        <Button x:Name="EditKeymapButton" Padding="8,4"
                                Command="{Binding StartEditCommand}"
                                ToolTip.Tip="{Binding EditButtonTooltip}"
                                ToolTip.ShowOnDisabled="True">
                            <PathIcon Width="14" Height="14"
                                      Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="4">
                        <StackPanel.Styles>
                            <Style Selector="StackPanel > Button">
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </StackPanel.Styles>

                        <!-- Live key highlighting — pulses a key cap when the firmware reports a press over HID -->
                        <Button x:Name="LiveButton"
                                Command="{Binding ToggleLiveHighlightingCommand}"
                                Classes="toggle"
                                Classes.active="{Binding IsLiveHighlightingEnabled}"
                                Padding="8,4"
                                ToolTip.Tip="{Binding [Tooltip_LiveHighlighting], Source={StaticResource Loc}}">
                            <PathIcon Width="16" Height="16"
                                      Data="M3 12h4l3-8 4 16 3-8h4" />
                        </Button>


                        <!-- Stacked / horizontal layout toggle -->
                        <Button x:Name="StackedLayoutButton"
                                Command="{Binding BoardLayout.ToggleStackedLayoutCommand}"
                                Classes="toggle"
                                Classes.active="{Binding BoardLayout.IsStackedLayout}"
                                Padding="8,4"
                                ToolTip.Tip="{Binding [Tooltip_StackedLayout], Source={StaticResource Loc}}">
                            <PathIcon Width="14" Height="14"
                                      Data="M4 2h16v8H4V2zm0 12h16v8H4v-8z" />
                        </Button>

                        <!-- Combo overlay toggle — numbered badges on combo
                             keys + legend tiles below the keyboard. -->
                        <Button x:Name="ComboOverlayButton"
                                Command="{Binding ComboLegend.ToggleOverlayCommand}"
                                Classes="toggle"
                                Classes.active="{Binding ComboLegend.IsOverlayVisible}"
                                Padding="8,4"
                                ToolTip.Tip="{Binding [Tooltip_ComboOverlay], Source={StaticResource Loc}}">
                            <PathIcon Width="14" Height="14"
                                      Data="M7 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm10 0a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM7 14a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm10 0a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM10 7h4M10 17h4M7 10v4M17 10v4" />
                        </Button>

                        <!-- Modifier symbol style: Apple icon = Mac (⌘ ⌥ ⌃ ⇪), Windows-logo icon = Windows (⊞ Alt Ctrl ⇧).
                             Not a Classes="toggle" — both states are equally "on", the icon itself communicates state. -->
                        <Button x:Name="ModifierStyleButton"
                                Command="{Binding Preferences.ToggleWindowsModifierStyleCommand}"
                                Padding="8,4"
                                ToolTip.Tip="{Binding [Tooltip_ModifierStyle], Source={StaticResource Loc}}">
                            <PathIcon Width="14" Height="14"
                                      Data="{Binding Preferences.ModifierStyleIconData}" />
                        </Button>

                        <!-- Refresh loaded JSON from disk -->
                        <Button x:Name="RefreshButton" Command="{Binding RefreshCommand}"
                                Padding="8,4"
                                IsEnabled="{Binding !IsEditing}"
                                IsVisible="{Binding HasLayoutLoaded}"
                                ToolTip.Tip="{Binding [Tooltip_Refresh], Source={StaticResource Loc}}">
                            <PathIcon Width="16" Height="16"
                                      Data="M18.537 19.567A9.961 9.961 0 0 1 12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10c0 2.136-.67 4.116-1.81 5.74L17 12h3a8 8 0 1 0-2.46 5.77z" />
                        </Button>

                        <!-- Pin (always on top) -->
                        <Button x:Name="PinButton"
                                Command="{Binding Preferences.TogglePinCommand}"
                                Classes="toggle"
                                Classes.active="{Binding Preferences.IsAlwaysOnTop}"
                                Padding="8,4"
                                ToolTip.Tip="{Binding [Tooltip_AlwaysOnTop], Source={StaticResource Loc}}">
                            <PathIcon Width="16" Height="16"
                                      Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2z" />
                        </Button>

                        <!-- Settings (background opacity, press color, layer colors) -->
                        <Button x:Name="SettingsButton" Command="{Binding OpenSettingsCommand}"
                                Padding="8,4"
                                ToolTip.Tip="{Binding [Tooltip_Settings], Source={StaticResource Loc}}">
                            <PathIcon Width="14" Height="14"
                                      Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
                        </Button>

                        <!-- Open log folder (diagnostic) -->
                        <Button x:Name="OpenLogFolderButton" Command="{Binding OpenLogFolderCommand}"
                                Padding="8,4"
                                ToolTip.Tip="{Binding [Tooltip_OpenLogFolder], Source={StaticResource Loc}}">
                            <PathIcon Width="14" Height="14"
                                      Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                        </Button>

                        <!-- Copy diagnostics -->
                        <Button x:Name="CopyDiagnosticsButton" Command="{Binding CopyDiagnosticsCommand}"
                                Padding="8,4"
                                ToolTip.Tip="{Binding [Tooltip_CopyDiagnostics], Source={StaticResource Loc}}">
                            <PathIcon Width="14" Height="14"
                                      Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
                        </Button>

                        <!-- Help / documentation: a small menu; the first item
                             opens the read-only shortcuts window, the second
                             opens the GitHub wiki. -->
                        <Button x:Name="HelpButton"
                                Padding="8,4"
                                ToolTip.Tip="{Binding [Tooltip_Help], Source={StaticResource Loc}}">
                            <PathIcon Width="14" Height="14"
                                      Data="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem Header="{Binding [Shortcuts_MenuItem], Source={StaticResource Loc}}"
                                              Command="{Binding OpenShortcutsCommand}" />
                                    <MenuItem Header="{Binding [Help_OnlineMenuItem], Source={StaticResource Loc}}"
                                              Command="{Binding OpenHelpCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <!-- Wizard entry point when the loaded keymap fits no known
                         board. Right-docked before the fill child; hidden
                         otherwise, so the status text is unaffected. -->
                    <Button DockPanel.Dock="Right"
                            Command="{Binding AddOwnBoardCommand}"
                            IsEnabled="{Binding !IsEditing}"
                            IsVisible="{Binding HasUnmatchedKeymap}"
                            Classes="link"
                            Padding="6,2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Status_CreateLayoutLink], Source={StaticResource Loc}}"
                                   FontSize="12" TextDecorations="Underline" />
                    </Button>
                    <!-- Fill child: transient/changing status only ("Switched to GO60", "Load error: …").
                         The persistent loaded-info text lives in the InfoButton tooltip on the left. -->
                    <TextBlock VerticalAlignment="Center"
                               MinWidth="20"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding StatusMessage}"
                               Foreground="{StaticResource Text}" />
                </DockPanel>
            </Border>

            <!-- Edit banner: shown while editing. Its own row next to the
                 status bar, so it travels with the bars when they swap. -->
            <Border x:Name="EditBanner" Grid.Row="1"
                    IsVisible="{Binding IsEditing}"
                    Background="{StaticResource AccentBlue}"
                    Padding="12,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                        <Button Classes="onAccent"
                                Command="{Binding Edit.UndoCommand}"
                                Focusable="False"
                                Padding="8,4"
                                ToolTip.Tip="{Binding [Tooltip_EditUndo], Source={StaticResource Loc}}">
                            <PathIcon Width="14" Height="14"
                                      Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" />
                        </Button>
                        <Button Classes="onAccent"
                                Command="{Binding Edit.RedoCommand}"
                                Focusable="False"
                                Padding="8,4"
                                ToolTip.Tip="{Binding [Tooltip_EditRedo], Source={StaticResource Loc}}">
                            <PathIcon Width="14" Height="14"
                                      Data="M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z" />
                        </Button>
                        <Button Classes="onAccent"
                                Command="{Binding DiscardEditCommand}"
                                Focusable="False"
                                Padding="8,4"
                                Content="{Binding [Edit_Discard], Source={StaticResource Loc}}" />
                        <Button Classes="onAccent primary"
                                Focusable="False"
                                Padding="8,4"
                                Command="{Binding Edit.SaveEditCommand}">
                            <StackPanel>
                                <TextBlock Text="{Binding [Edit_Save], Source={StaticResource Loc}}"
                                           IsVisible="{Binding !Edit.IsSaving}" />
                                <TextBlock Text="{Binding [Edit_Saving], Source={StaticResource Loc}}"
                                           IsVisible="{Binding Edit.IsSaving}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding Edit.BannerText}"
                               Foreground="{StaticResource BgBase}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Combo legend: WrapPanel of numbered tiles, one per
                 active-layer combo. Docked alongside the tabs — same
                 edge as the bars panel, always closest to the keyboard.
                 IsVisible rides the overlay toggle OR an open edit, so
                 the row also collapses cleanly when both are off. In
                 edit mode a "+" adds a combo and each tile grows a ⋮
                 menu; double-click opens the combo dialog. -->
            <!-- Combo legend: the tile strip lives in ComboLegendView, docked
                 alongside the tabs — same edge as the bars panel, always
                 closest to the keyboard. IsVisible rides the overlay toggle
                 OR an open edit, so the row also collapses cleanly when both
                 are off. Row placement and background stay here. -->
            <Border x:Name="ComboLegend" Grid.Row="3"
                    IsVisible="{Binding ComboLegend.IsLegendVisible}"
                    Background="{Binding Preferences.TabBackground, Converter={StaticResource HexToBrush}}"
                    Padding="8,4">
                <views:ComboLegendView DataContext="{Binding ComboLegend}" />
            </Border>

            <!-- Layer tabs -->
            <Border x:Name="LayerTabs" Grid.Row="2"
                    Background="{Binding Preferences.TabBackground, Converter={StaticResource HexToBrush}}"
                    Padding="8,2">
                <views:LayerTabsView DataContext="{Binding LayerTabs}" />
            </Border>
        </Grid>

        <!-- Board visualization area -->
        <Border Grid.Row="1" Padding="16"
                Background="{Binding Preferences.BoardBackground, Converter={StaticResource HexToBrush}}">
            <views:BoardView DataContext="{Binding}" />
        </Border>

        <!-- Transient error toast: fades in/out via Opacity transition.
             Stays in the layout when hidden so the fade-out animation can run;
             IsHitTestVisible is gated on the same class so clicks pass through
             to the board when the toast isn't shown. -->
        <Border Grid.Row="1"
                Classes.show="{Binding Toast.IsVisible}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,12,0,0"
                Padding="16,10"
                CornerRadius="6"
                Background="{StaticResource ErrorBg}" BorderBrush="{StaticResource ErrorBorder}" BorderThickness="1"
                MaxWidth="640">
            <Border.Styles>
                <Style Selector="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="Border.show">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </Style>
            </Border.Styles>
            <Button Command="{Binding Toast.DismissCommand}"
                    Background="Transparent" BorderThickness="0"
                    Padding="0" Cursor="Hand"
                    Focusable="False">
                <TextBlock Text="{Binding Toast.Message}"
                           Foreground="{StaticResource ErrorText}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
            </Button>
        </Border>

        <!-- Key ring backdrop: last child of the root grid, spanning all three
             rows, so it covers bars, board and toast. -->
        <views:KeyRingOverlay x:Name="KeyRingLayer" Grid.Row="0" Grid.RowSpan="3" />

    </Grid>

</Window>
