<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LViz.App.ViewModels"
        xmlns:views="using:LViz.App.Views"
        x:Class="LViz.App.Views.LayoutEditWindow"
        x:DataType="vm:LayoutEditWindowViewModel"
        Title="{Binding Title}"
        Width="900" Height="600"
        MinWidth="640" MinHeight="440"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}">

    <DockPanel Margin="16">

        <!-- Bottom bar: error text left, Reset / Cancel / Save right — the
             wizard's bar minus Back/Next. Reset and Save gate on the editor's
             own IsModified, so both are dead until something actually moves. -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource AccentRed}"
                       FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Grid.Column="1"
                    Content="{Binding [Wizard_Reset], Source={StaticResource Loc}}"
                    Command="{Binding Editor.ResetCommand}"
                    IsEnabled="{Binding Editor.IsModified}"
                    Margin="8,0,0,0" />
            <Button Grid.Column="2"
                    Content="{Binding [Wizard_Cancel], Source={StaticResource Loc}}"
                    Command="{Binding CancelCommand}"
                    Margin="8,0,0,0" />
            <Button Grid.Column="3"
                    Content="{Binding [Wizard_Save], Source={StaticResource Loc}}"
                    Command="{Binding SaveCommand}"
                    Margin="8,0,0,0"
                    Classes="accent"
                    IsDefault="True" />
        </Grid>

        <!-- Same hint the wizard's adjust step teaches with. -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding [Wizard_Step2Hint], Source={StaticResource Loc}}"
                   FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Text}"
                   Margin="0,0,0,10" />

        <Border BorderBrush="{StaticResource BgSurface0}" BorderThickness="1" CornerRadius="6"
                Background="{StaticResource BgBase}" Padding="12">
            <views:LayoutEditorCanvas x:Name="Canvas" Editor="{Binding Editor}" />
        </Border>

    </DockPanel>

</Window>
