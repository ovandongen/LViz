<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LViz.App.ViewModels"
             xmlns:conv="using:LViz.App.Converters"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="LViz.App.Views.SettingsTabs.LayersTab"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="12">

            <TextBlock Text="{Binding LayersHeader}"
                       FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
            <TextBlock Text="{Binding [Settings_LayersHint], Source={StaticResource Loc}}"
                       Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding LayerEntries}"
                          IsVisible="{Binding HasLayoutForLayers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LayerSettingsEntry">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,3,0,3">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DisplayName}"
                                       Foreground="{StaticResource Text}"
                                       VerticalAlignment="Center" />

                            <!-- Show/hide the main-form layer button -->
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsShown, Mode=TwoWay}"
                                      IsEnabled="{Binding CanHide}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      ToolTip.Tip="{Binding [Settings_LayerShowTooltip], Source={StaticResource Loc}}" />

                            <!-- Color swatch + picker -->
                            <Button Grid.Column="2" Padding="2"
                                    Background="Transparent" BorderThickness="0">
                                <Border Width="56" Height="22" CornerRadius="3"
                                        Background="{Binding Color.ColorHex, Converter={StaticResource HexToBrush}}"
                                        BorderBrush="{StaticResource BgSurface1}" BorderThickness="1" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <ColorView Color="{Binding Color.Color, Mode=TwoWay}"
                                                   IsAlphaVisible="False" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Grid.Column="3" Margin="6,0,0,0"
                                    Padding="8,2"
                                    Content="{Binding [Settings_LayerColorsReset], Source={StaticResource Loc}}"
                                    Command="{Binding Color.ResetCommand}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
