<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LViz.App.ViewModels"
        xmlns:conv="using:LViz.App.Converters"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="LViz.App.Views.EditPipelineDialog"
        x:DataType="vm:EditPipelineDialogViewModel"
        Name="PipelineDialogRoot"
        Title="{Binding DialogTitle}"
        Width="600" Height="640"
        MinWidth="480" MinHeight="400"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}">

    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>

    <!-- Compact control styling is now global (App.axaml). -->

    <DockPanel Margin="16">

        <!-- Header: title + name -->
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                       Text="{Binding DialogTitle}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="{Binding [Settings_Pipeline_Name], Source={StaticResource Loc}}"
                           Foreground="{StaticResource Text}" FontSize="12" />
                <TextBox Grid.Column="1" MaxLength="80"
                         Watermark="{Binding [Settings_Pipeline_NewName], Source={StaticResource Loc}}"
                         Text="{Binding Working.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Border Height="1" Background="{StaticResource BgSurface0}" />
        </StackPanel>

        <!-- Bottom action bar -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0"
                    IsVisible="{Binding IsExisting}"
                    ToolTip.Tip="{Binding [Settings_Pipeline_Delete], Source={StaticResource Loc}}"
                    Click="OnDeleteClick">
                <i:Icon Value="fa-solid fa-trash-can" />
            </Button>
            <Button Grid.Column="2"
                    Content="{Binding [Settings_Pipeline_Test], Source={StaticResource Loc}}"
                    Command="{Binding TestCommand}" />
            <Button Grid.Column="3" Margin="8,0,0,0"
                    Content="{Binding [Settings_Pipeline_Cancel], Source={StaticResource Loc}}"
                    Click="OnCancelClick" />
            <Button Grid.Column="4" Margin="8,0,0,0"
                    Classes="accent" IsDefault="True"
                    IsEnabled="{Binding CanSave}"
                    Content="{Binding [Settings_Pipeline_Save], Source={StaticResource Loc}}"
                    Click="OnSaveClick" />
        </Grid>

        <!-- Cycle warning: docked after the action bar so it sits just above it. -->
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   Text="{Binding CycleError}" IsVisible="{Binding HasCycleError}"
                   Foreground="#E06C75" FontSize="12" TextWrapping="Wrap" />


        <!-- Steps header + add picker (docked above the scrollable list). -->
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
            <TextBlock Text="{Binding [Settings_Pipeline_SectionSteps], Source={StaticResource Loc}}"
                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}" />

            <Grid ColumnDefinitions="Auto,180,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="{Binding [Settings_Pipeline_StepKind], Source={StaticResource Loc}}"
                           Foreground="{StaticResource Text}" FontSize="12" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding StepKinds}"
                          SelectedItem="{Binding NewStepKind, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PipelineStepKindOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2"
                        Content="{Binding [Settings_Pipeline_AddStep], Source={StaticResource Loc}}"
                        Command="{Binding AddStepCommand}" />
            </Grid>

            <Border Height="1" Background="{StaticResource BgSurface0}" />

            <TextBlock Text="{Binding [Settings_Pipeline_NoSteps], Source={StaticResource Loc}}"
                       Foreground="{StaticResource TextMuted}" FontSize="11" FontStyle="Italic"
                       IsVisible="{Binding HasNoSteps}" />
        </StackPanel>

        <!-- Fill child: the scrollable step list. As the DockPanel's last child it
             gets the bounded remaining height, so it scrolls instead of overflowing
             the docked action bar. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Working.Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StepEditRow">
                            <Border Margin="0,4,0,4" Padding="6" CornerRadius="4"
                                    Background="{StaticResource BgSurface0}">
                                <StackPanel Spacing="3">
                                    <!-- Kind picker + small top-right icon buttons (up / down / delete). -->
                                    <Grid ColumnDefinitions="180,*,Auto,Auto,Auto" ColumnSpacing="4">
                                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                                  ItemsSource="{Binding KindOptions}"
                                                  SelectedItem="{Binding SelectedKindOption, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PipelineStepKindOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="2" VerticalAlignment="Top" MinWidth="0" MinHeight="0" Padding="6,4"
                                                ToolTip.Tip="{Binding [Settings_Pipeline_MoveUp], Source={StaticResource Loc}}"
                                                Command="{Binding DataContext.MoveStepUpCommand, ElementName=PipelineDialogRoot}"
                                                CommandParameter="{Binding}">
                                            <i:Icon Value="fa-solid fa-chevron-up" />
                                        </Button>
                                        <Button Grid.Column="3" VerticalAlignment="Top" MinWidth="0" MinHeight="0" Padding="6,4"
                                                ToolTip.Tip="{Binding [Settings_Pipeline_MoveDown], Source={StaticResource Loc}}"
                                                Command="{Binding DataContext.MoveStepDownCommand, ElementName=PipelineDialogRoot}"
                                                CommandParameter="{Binding}">
                                            <i:Icon Value="fa-solid fa-chevron-down" />
                                        </Button>
                                        <Button Grid.Column="4" VerticalAlignment="Top" MinWidth="0" MinHeight="0" Padding="6,4"
                                                ToolTip.Tip="{Binding [Settings_Pipeline_Remove], Source={StaticResource Loc}}"
                                                Command="{Binding DataContext.RemoveStepCommand, ElementName=PipelineDialogRoot}"
                                                CommandParameter="{Binding}">
                                            <i:Icon Value="fa-solid fa-trash-can" />
                                        </Button>
                                    </Grid>

                                    <!-- Target device (RGB / pointing steps) -->
                                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8"
                                          IsVisible="{Binding IsDeviceStep}">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{Binding [Settings_Pipeline_TargetDevice], Source={StaticResource Loc}}"
                                                   Foreground="{StaticResource Text}" FontSize="12" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding DeviceOptions}"
                                                  SelectedItem="{Binding SelectedTargetDevice, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PipelineTargetOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Keyboard layer: target device (visualized keyboard or a layer-capable bus device) -->
                                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8"
                                          IsVisible="{Binding IsKeyboardLayer}">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{Binding [Settings_Pipeline_TargetDevice], Source={StaticResource Loc}}"
                                                   Foreground="{StaticResource Text}" FontSize="12" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding LayerTargetOptions}"
                                                  SelectedItem="{Binding SelectedLayerTarget, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PipelineTargetOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Keyboard layer: action (only for a device target that advertises >1 layer action) -->
                                    <Grid ColumnDefinitions="120,180" ColumnSpacing="8"
                                          IsVisible="{Binding IsDeviceLayer}">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{Binding [Settings_Pipeline_LayerActionLabel], Source={StaticResource Loc}}"
                                                   Foreground="{StaticResource Text}" FontSize="12" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding LayerActions}"
                                                  SelectedItem="{Binding SelectedLayerAction, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PipelineLayerActionOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Keyboard layer: index -->
                                    <Grid ColumnDefinitions="120,140" ColumnSpacing="8"
                                          IsVisible="{Binding IsKeyboardLayer}">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{Binding [Settings_Pipeline_Layer], Source={StaticResource Loc}}"
                                                   Foreground="{StaticResource Text}" FontSize="12" />
                                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="255" Increment="1" FormatString="0"
                                                       Value="{Binding LayerIndex, Mode=TwoWay}" />
                                    </Grid>

                                    <!-- Pointing action + value -->
                                    <Grid ColumnDefinitions="120,180,140" ColumnSpacing="8"
                                          IsVisible="{Binding IsPointing}">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{Binding [Settings_Pipeline_PointingAction], Source={StaticResource Loc}}"
                                                   Foreground="{StaticResource Text}" FontSize="12" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding PointingOptions}"
                                                  SelectedItem="{Binding SelectedPointing, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PointingActionOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <NumericUpDown Grid.Column="2" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0"
                                                       Value="{Binding PointingValue, Mode=TwoWay}" />
                                    </Grid>

                                    <!-- RGB -->
                                    <StackPanel Spacing="3" IsVisible="{Binding IsRgb}">
                                        <Grid ColumnDefinitions="120,140" ColumnSpacing="8">
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                      Content="{Binding [Settings_DeviceRouting_RgbOn], Source={StaticResource Loc}}"
                                                      IsChecked="{Binding Rgb.IncludeOn, Mode=TwoWay}" />
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                      IsEnabled="{Binding Rgb.IncludeOn}"
                                                      IsChecked="{Binding Rgb.On, Mode=TwoWay}"
                                                      Content="{Binding [Settings_DeviceRouting_On], Source={StaticResource Loc}}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="120,140" ColumnSpacing="8">
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                      Content="{Binding [Settings_DeviceRouting_RgbColor], Source={StaticResource Loc}}"
                                                      IsChecked="{Binding Rgb.IncludeColor, Mode=TwoWay}" />
                                            <Button Grid.Column="1" Padding="3" HorizontalAlignment="Left"
                                                    IsEnabled="{Binding Rgb.IncludeColor}">
                                                <Border Width="56" Height="22" CornerRadius="3"
                                                        Background="{Binding Rgb.ColorHex, Converter={StaticResource HexToBrush}}"
                                                        BorderBrush="{StaticResource BgSurface1}" BorderThickness="1" />
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <ColorView Color="{Binding Rgb.Color, Mode=TwoWay}" IsAlphaVisible="False" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                        <Grid ColumnDefinitions="120,140" ColumnSpacing="8">
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                      Content="{Binding [Settings_DeviceRouting_RgbBrightness], Source={StaticResource Loc}}"
                                                      IsChecked="{Binding Rgb.IncludeBrightness, Mode=TwoWay}" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                    IsEnabled="{Binding Rgb.IncludeBrightness}"
                                                    Value="{Binding Rgb.Brightness, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="120,140" ColumnSpacing="8">
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                      Content="{Binding [Settings_DeviceRouting_RgbEffect], Source={StaticResource Loc}}"
                                                      IsChecked="{Binding Rgb.IncludeEffect, Mode=TwoWay}" />
                                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="255" Increment="1" FormatString="0"
                                                           IsEnabled="{Binding Rgb.IncludeEffect}"
                                                           Value="{Binding Rgb.Effect, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Launch -->
                                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8"
                                          IsVisible="{Binding IsLaunch}">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{Binding [Settings_Pipeline_LaunchTarget], Source={StaticResource Loc}}"
                                                   Foreground="{StaticResource Text}" FontSize="12" />
                                        <TextBox Grid.Column="1" MaxLength="1000"
                                                 Text="{Binding LaunchTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <!-- Shell -->
                                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8"
                                          IsVisible="{Binding IsShell}">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{Binding [Settings_Pipeline_ShellCommand], Source={StaticResource Loc}}"
                                                   Foreground="{StaticResource Text}" FontSize="12" />
                                        <TextBox Grid.Column="1" MaxLength="1000"
                                                 Text="{Binding ShellCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <!-- Delay -->
                                    <Grid ColumnDefinitions="120,140" ColumnSpacing="8"
                                          IsVisible="{Binding IsDelay}">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{Binding [Settings_Pipeline_DelayMs], Source={StaticResource Loc}}"
                                                   Foreground="{StaticResource Text}" FontSize="12" />
                                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="600000" Increment="50" FormatString="0"
                                                       Value="{Binding DelayMs, Mode=TwoWay}" />
                                    </Grid>

                                    <!-- Run pipeline (sub-pipeline) -->
                                    <Grid ColumnDefinitions="120,*" ColumnSpacing="8"
                                          IsVisible="{Binding IsPipeline}">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{Binding [Settings_Pipeline_SubPipeline], Source={StaticResource Loc}}"
                                                   Foreground="{StaticResource Text}" FontSize="12" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding PipelineRefOptions}"
                                                  SelectedItem="{Binding PipelineRef, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
