<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LViz.App.ViewModels"
        xmlns:views="using:LViz.App.Views"
        x:Class="LViz.App.Views.LayoutWizardWindow"
        x:DataType="vm:LayoutWizardViewModel"
        x:Name="WizardWin"
        Title="{Binding [Wizard_Title], Source={StaticResource Loc}}"
        Width="900" Height="640"
        MinWidth="700" MinHeight="520"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}">

    <DockPanel Margin="16">

        <!-- Bottom bar: error text left, Cancel / Back / Next / Save right.
             Back hides on step 0, Next hides on step 2, Save shows only on
             step 2 — the VM's CanExecute gates when Next/Save are enabled. -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource AccentRed}"
                       FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Grid.Column="1"
                    Content="{Binding [Wizard_Cancel], Source={StaticResource Loc}}"
                    Command="{Binding CancelCommand}"
                    Margin="8,0,0,0" />
            <Button Grid.Column="2"
                    Content="{Binding [Wizard_Back], Source={StaticResource Loc}}"
                    Command="{Binding BackCommand}"
                    Margin="8,0,0,0"
                    IsVisible="{Binding !IsSourceStep}" />
            <Button Grid.Column="3"
                    Content="{Binding [Wizard_Next], Source={StaticResource Loc}}"
                    Command="{Binding NextCommand}"
                    Margin="8,0,0,0"
                    IsVisible="{Binding !IsSaveStep}" />
            <Button Grid.Column="4"
                    Content="{Binding [Wizard_Save], Source={StaticResource Loc}}"
                    Command="{Binding SaveCommand}"
                    Margin="8,0,0,0"
                    Classes="accent"
                    IsDefault="True"
                    IsVisible="{Binding IsSaveStep}" />
        </Grid>

        <!-- Step 0 — source: scan a zmk-config folder or one board file, or
             answer the questions (grid source) instead. -->
        <DockPanel IsVisible="{Binding IsSourceStep}">
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
                <TextBlock Text="{Binding [Wizard_Step1Header], Source={StaticResource Loc}}"
                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                <TextBlock Text="{Binding [Wizard_Step1Hint], Source={StaticResource Loc}}"
                           FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Text}" />
                <TextBlock Text="{Binding LoadedKeymapNotice}"
                           FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSubtle}"
                           IsVisible="{Binding LoadedKeymapNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding [Wizard_BrowseFolder], Source={StaticResource Loc}}"
                            Command="{Binding BrowseFolderCommand}" />
                    <Button Content="{Binding [Wizard_BrowseFile], Source={StaticResource Loc}}"
                            Command="{Binding BrowseFileCommand}" />
                </StackPanel>
                <Button Classes="link"
                        Content="{Binding [Wizard_BuildFromQuestions], Source={StaticResource Loc}}"
                        Command="{Binding UseGridSourceCommand}"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding !IsGridSource}" />
            </StackPanel>

            <!-- Grid source — the questions whose answers feed
                 GridLayoutGenerator through the view-model. -->
            <StackPanel DockPanel.Dock="Top" Spacing="8" IsVisible="{Binding IsGridSource}">
                <TextBlock Text="{Binding [Wizard_GridHeader], Source={StaticResource Loc}}"
                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                <CheckBox Content="{Binding [Wizard_GridSplit], Source={StaticResource Loc}}"
                          IsChecked="{Binding GridSplit, Mode=TwoWay}" />
                <!-- Same shape as the Settings steppers: label column, then a
                     140px stepper column, so the number isn't cut off by the
                     spinner buttons. -->
                <Grid ColumnDefinitions="Auto,140" RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="8" RowSpacing="6" HorizontalAlignment="Left">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding [Wizard_GridRows], Source={StaticResource Loc}}"
                               FontSize="12" Foreground="{StaticResource Text}"
                               VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                   Value="{Binding GridRows, Mode=TwoWay}"
                                   Minimum="{Binding GridMinRows}" Maximum="{Binding GridMaxRows}"
                                   Increment="1" FormatString="0" />
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{Binding [Wizard_GridColumns], Source={StaticResource Loc}}"
                               FontSize="12" Foreground="{StaticResource Text}"
                               VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Value="{Binding GridColumns, Mode=TwoWay}"
                                   Minimum="{Binding GridMinColumns}" Maximum="{Binding GridMaxColumns}"
                                   Increment="1" FormatString="0" />
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="{Binding [Wizard_GridThumbKeys], Source={StaticResource Loc}}"
                               FontSize="12" Foreground="{StaticResource Text}"
                               VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1"
                                   Value="{Binding GridThumbKeys, Mode=TwoWay}"
                                   Minimum="{Binding GridMinThumbKeys}" Maximum="{Binding GridMaxThumbKeys}"
                                   Increment="1" FormatString="0" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding GridKeyCountText}"
                               FontSize="12" Foreground="{StaticResource Text}" />
                    <TextBlock Text="✓"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentGreen}"
                               IsVisible="{Binding GridMatchesKeymap}" />
                </StackPanel>
                <TextBlock Text="{Binding [Wizard_GridHint], Source={StaticResource Loc}}"
                           FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSubtle}" />
                <Button Classes="link"
                        Content="{Binding [Wizard_UseBoardFiles], Source={StaticResource Loc}}"
                        Command="{Binding UseFileSourceCommand}"
                        HorizontalAlignment="Left" />
            </StackPanel>

            <!-- File source — the scan of a folder or one board file and
                 its candidate list; hidden entirely in grid mode. -->
            <DockPanel IsVisible="{Binding !IsGridSource}">
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,4">
                    <TextBlock Text="{Binding SourcePath}"
                               FontSize="12" Foreground="{StaticResource TextSubtle}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding SourcePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsScanning}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding SourceInfo}"
                           FontSize="12" Foreground="{StaticResource TextSubtle}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           IsVisible="{Binding SourceInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <ListBox ItemsSource="{Binding Candidates}"
                         SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LayoutCandidateItem">
                            <StackPanel Spacing="2" Margin="0,2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="✓"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource AccentGreen}"
                                               IsVisible="{Binding MatchesKeymap}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}"
                                           FontSize="11" Foreground="{StaticResource TextSubtle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DockPanel>

        <!-- Step 1 — adjust: the candidate's keys in the shared editor;
             pointer and keyboard input go to LayoutEditorCanvas. -->
        <DockPanel IsVisible="{Binding IsPreviewStep}">
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
                <TextBlock Text="{Binding [Wizard_Step2Header], Source={StaticResource Loc}}"
                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                <TextBlock Text="{Binding [Wizard_Step2Hint], Source={StaticResource Loc}}"
                           FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Text}" />
                <TextBlock Text="{Binding PreviewWarning}"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource AccentYellow}"
                           IsVisible="{Binding PreviewWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Content="{Binding [Wizard_Reset], Source={StaticResource Loc}}"
                        Command="{Binding Editor.ResetCommand}"
                        IsEnabled="{Binding Editor.IsModified}"
                        HorizontalAlignment="Right" />
            </StackPanel>

            <Border BorderBrush="{StaticResource BgSurface0}" BorderThickness="1" CornerRadius="6"
                    Background="{StaticResource BgBase}" Padding="12">
                <views:LayoutEditorCanvas x:Name="EditorCanvas" Editor="{Binding Editor}" />
            </Border>
        </DockPanel>

        <!-- Step 2 — save: name, device name, optional copy into zmk-config. -->
        <StackPanel IsVisible="{Binding IsSaveStep}" Spacing="10">
            <TextBlock Text="{Binding [Wizard_Step3Header], Source={StaticResource Loc}}"
                       FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />

            <StackPanel Spacing="2">
                <TextBlock Text="{Binding [Wizard_Name], Source={StaticResource Loc}}"
                           FontSize="11" Foreground="{StaticResource TextSubtle}" />
                <TextBox Text="{Binding Name, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="{Binding [Wizard_HidName], Source={StaticResource Loc}}"
                           FontSize="11" Foreground="{StaticResource TextSubtle}" />
                <TextBox Text="{Binding HidName, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="4"
                        IsVisible="{Binding ConnectedDeviceNames.Count}">
                <TextBlock Text="{Binding [Wizard_ConnectedDevices], Source={StaticResource Loc}}"
                           FontSize="11" Foreground="{StaticResource TextSubtle}" />
                <ItemsControl ItemsSource="{Binding ConnectedDeviceNames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Content="{Binding}"
                                    Command="{Binding DataContext.UseDeviceNameCommand, ElementName=WizardWin}"
                                    CommandParameter="{Binding}"
                                    Padding="8,2" Margin="0,0,6,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <CheckBox Content="{Binding [Wizard_AlsoSaveToConfig], Source={StaticResource Loc}}"
                      IsChecked="{Binding AlsoSaveToConfig, Mode=TwoWay}"
                      IsVisible="{Binding CanSaveToConfig}" />
        </StackPanel>

    </DockPanel>

</Window>
