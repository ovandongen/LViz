<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LViz.App.ViewModels"
        xmlns:conv="using:LViz.App.Converters"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="LViz.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Name="SettingsRoot"
        Title="{Binding [Title_Settings], Source={StaticResource Loc}}"
        Width="760" Height="640"
        MinWidth="640" MinHeight="320"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
        <conv:AppLayerRuleLabelConverter x:Key="AppLayerRuleLabel" />
    </Window.Resources>

    <DockPanel Margin="8">

        <!-- Slim version footer: docked at the bottom so the current version
             stays visible across all tabs. The interactive "Check now" /
             auto-check toggle lives in the General tab's Updates section. -->
        <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource BgSurface0}" Margin="0,8,0,0" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,8,8,4" Spacing="8">
            <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource TextMuted}" FontSize="12"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TabControl>

        <!-- The headers no longer all fit at the window's min width. Rather than
             wrap them onto a second row or force the window wider, shrink the
             header font/padding and keep them on one horizontally scrollable
             row: a horizontal StackPanel for the strip, wrapped in a ScrollViewer
             by the template override below. -->
        <TabControl.Styles>
            <Style Selector="TabItem">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </TabControl.Styles>

        <TabControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </TabControl.ItemsPanel>

        <!-- Mirrors the Fluent TabControl template (Border › DockPanel ›
             ItemsPresenter + selected-content host), with the header
             ItemsPresenter wrapped in a horizontal ScrollViewer so an
             overflowing strip scrolls instead of clipping or widening. -->
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Border BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <DockPanel>
                        <ScrollViewer DockPanel.Dock="Top"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </ScrollViewer>
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </TabControl.Template>

        <!-- General tab: app-wide settings (not scoped per layer). -->
        <TabItem Header="{Binding [Settings_Tab_General], Source={StaticResource Loc}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" Spacing="8">

                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [Settings_KeyboardProfile], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_KeyboardProfileHint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                        <ComboBox MinWidth="200" Margin="0,4,0,0"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding KeyboardChoices}"
                                  SelectedItem="{Binding SelectedKeyboardProfile, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BgSurface0}" />

                    <!-- Background opacity -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [Settings_BackgroundOpacity], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_BackgroundOpacityHint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Slider Grid.Column="0"
                                    Minimum="0" Maximum="1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding MainViewModel.BackgroundOpacity, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding BackgroundOpacityPercent}"
                                       Foreground="{StaticResource Text}"
                                       MinWidth="44"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BgSurface0}" />

                    <!-- Press-highlight color -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [Settings_PressHighlight], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_PressHighlightHint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                        <Button Padding="2" Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0">
                            <Border Width="56" Height="22" CornerRadius="3"
                                    Background="{Binding PressHighlightColorHex, Converter={StaticResource HexToBrush}}"
                                    BorderBrush="{StaticResource BgSurface1}" BorderThickness="1" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ColorView Color="{Binding PressHighlightColor, Mode=TwoWay}"
                                               IsAlphaVisible="False" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BgSurface0}" />

                    <!-- Global show/hide hotkey. Single key only (no modifier UI today);
                         the chosen key is auto-excluded from the layer-key picker on the
                         Layers tab so the two can't collide. Hidden on Linux —
                         Wayland blocks global hooks from unfocused windows. -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsGlobalHotkeySupported}">
                        <TextBlock Text="{Binding [Settings_GlobalHotkey], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_GlobalHotkeyHint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                        <ComboBox MinWidth="120" Margin="0,4,0,0"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding HotkeyKeyChoices}"
                                  SelectedItem="{Binding MainViewModel.HotkeyKey, Mode=TwoWay}" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BgSurface0}" IsVisible="{Binding IsGlobalHotkeySupported}" />

                    <!-- Tray icon active-layer tint -->
                    <StackPanel Spacing="4">
                        <CheckBox Content="{Binding [Settings_ColorTrayIcon], Source={StaticResource Loc}}"
                                  IsChecked="{Binding MainViewModel.ColorTrayIconByActiveLayer, Mode=TwoWay}" />
                        <TextBlock Text="{Binding [Settings_ColorTrayIconHint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BgSurface0}" />

                    <!-- Layout: top-hand picker for stacked mode. Greyed out
                         until the user enables stacked layout via the toolbar. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [Settings_Layout], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0"
                                    IsEnabled="{Binding MainViewModel.BoardLayout.IsStackedLayout}">
                            <TextBlock Text="{Binding [Settings_TopHand], Source={StaticResource Loc}}"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextSubtle}" FontSize="12" />
                            <ComboBox MinWidth="100"
                                      ItemsSource="{Binding AvailableTopHands}"
                                      SelectedItem="{Binding MainViewModel.BoardLayout.StackedTopHand, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BgSurface0}" />

                    <!-- Updates: auto-check toggle, manual "Check now", status
                         readout, restart-to-install button when staged. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [Settings_Updates], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <CheckBox Content="{Binding [Settings_AutoCheckForUpdates], Source={StaticResource Loc}}"
                                  IsChecked="{Binding AutoCheckForUpdates, Mode=TwoWay}" />
                        <TextBlock Text="{Binding [Settings_AutoCheckHint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Content="{Binding [Settings_CheckNow], Source={StaticResource Loc}}"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    IsEnabled="{Binding !IsCheckingForUpdates}" />
                            <Button Content="{Binding [Settings_RestartToInstall], Source={StaticResource Loc}}"
                                    Command="{Binding RestartToInstallCommand}"
                                    IsVisible="{Binding CanRestartToInstall}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateStatusMessage}"
                                   Foreground="{StaticResource AccentGreen}" FontSize="12"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasUpdateStatus}" />
                        <TextBlock Text="{Binding LastCheckedDisplay}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12"
                                   IsVisible="{Binding LastCheckedDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BgSurface0}" />

                    <!-- Command-line tool: symlinks `lviz` onto PATH so scripts can
                         drive the running app. Buttons appear only on builds where
                         the app can install it (installed build, macOS/Linux); the
                         detail line always explains the current state. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [Settings_CliTool], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_CliTool_Hint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0"
                                    IsVisible="{Binding IsCliToolActionAvailable}">
                            <Button Content="{Binding [Settings_CliTool_Install], Source={StaticResource Loc}}"
                                    Command="{Binding InstallCliToolCommand}"
                                    IsVisible="{Binding !IsCliToolInstalled}" />
                            <Button Content="{Binding [Settings_CliTool_Remove], Source={StaticResource Loc}}"
                                    Command="{Binding UninstallCliToolCommand}"
                                    IsVisible="{Binding IsCliToolInstalled}" />
                        </StackPanel>
                        <TextBlock Text="{Binding CliToolDetail}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding CliToolDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Layers tab: per-loaded-layer color override on one row each.
             Rebuilds when the layout loads or active keyboard profile changes. -->
        <TabItem Header="{Binding [Settings_Tab_Layers], Source={StaticResource Loc}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" Spacing="12">

                    <TextBlock Text="{Binding LayersHeader}"
                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock Text="{Binding [Settings_LayersHint], Source={StaticResource Loc}}"
                               Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding LayerEntries}"
                                  IsVisible="{Binding HasLayoutForLayers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LayerSettingsEntry">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3,0,3">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               Foreground="{StaticResource Text}"
                                               VerticalAlignment="Center" />

                                    <!-- Color swatch + picker -->
                                    <Button Grid.Column="1" Padding="2"
                                            Background="Transparent" BorderThickness="0">
                                        <Border Width="56" Height="22" CornerRadius="3"
                                                Background="{Binding Color.ColorHex, Converter={StaticResource HexToBrush}}"
                                                BorderBrush="{StaticResource BgSurface1}" BorderThickness="1" />
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <ColorView Color="{Binding Color.Color, Mode=TwoWay}"
                                                           IsAlphaVisible="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <Button Grid.Column="2" Margin="6,0,0,0"
                                            Padding="8,2"
                                            Content="{Binding [Settings_LayerColorsReset], Source={StaticResource Loc}}"
                                            Command="{Binding Color.ResetCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Auto-switch tab: per-keyboard rules mapping focused app → ZMK layer.
             Pushing layers to firmware needs the Raw HID source connected; the
             tab is hidden while we're still searching for the keyboard. -->
        <TabItem Header="{Binding [Settings_Tab_AutoSwitch], Source={StaticResource Loc}}"
                 IsVisible="{Binding MainViewModel.IsAppRulesTabVisible}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" Spacing="16">

                    <!-- Engine section: master enable + fallback policy. -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [Settings_AutoSwitch_SectionEngine], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_AutoSwitch_Hint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />

                        <CheckBox Content="{Binding [Settings_AutoSwitch_Enable], Source={StaticResource Loc}}"
                                  IsChecked="{Binding MainViewModel.AutoSwitch.IsEnabled, Mode=TwoWay}"
                                  Foreground="{StaticResource Text}"
                                  Margin="0,4,0,0" />

                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <TextBlock Text="{Binding [Settings_AutoSwitch_FallbackLabel], Source={StaticResource Loc}}"
                                       Foreground="{StaticResource Text}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton GroupName="AutoSwitchFallback"
                                             Content="{Binding [Settings_AutoSwitch_FallbackBase], Source={StaticResource Loc}}"
                                             IsChecked="{Binding IsFallbackBase, Mode=TwoWay}"
                                             Foreground="{StaticResource Text}" />
                                <RadioButton GroupName="AutoSwitchFallback"
                                             Content="{Binding [Settings_AutoSwitch_FallbackPrevious], Source={StaticResource Loc}}"
                                             IsChecked="{Binding IsFallbackPrevious, Mode=TwoWay}"
                                             Foreground="{StaticResource Text}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BgSurface0}" />

                    <!-- Exit-tap key: a single firmware key position that
                         toggles the engine between the rule-driven layer
                         and the fallback target when double-tapped. Pressed
                         on the physical keyboard; we consume the firmware
                         key events (regardless of OS keypress permission)
                         via the submodule's MultiTapDetector. -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [Settings_AutoSwitch_SectionExitKey], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_AutoSwitch_ExitKeysHint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock Text="{Binding ExitTapSummary}"
                                       Foreground="{StaticResource AccentGreen}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       MinWidth="160" />
                            <Button Content="{Binding [Settings_AutoSwitch_PickExitKeys], Source={StaticResource Loc}}"
                                    Click="OnPickExitKeysClick" />
                            <Button Content="{Binding [Settings_AutoSwitch_ClearExitKeys], Source={StaticResource Loc}}"
                                    Command="{Binding ClearExitTapCommand}"
                                    IsEnabled="{Binding HasExitTap}" />
                        </StackPanel>

                        <CheckBox Content="{Binding [Settings_AutoSwitch_ExitOnTransparent], Source={StaticResource Loc}}"
                                  IsChecked="{Binding IsAutoSwitchExitOnTransparentKey, Mode=TwoWay}"
                                  Foreground="{StaticResource Text}"
                                  Margin="0,6,0,0" />
                        <CheckBox Content="{Binding [Settings_AutoSwitch_ExitOnEmpty], Source={StaticResource Loc}}"
                                  IsChecked="{Binding IsAutoSwitchExitOnEmptyKey, Mode=TwoWay}"
                                  Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_AutoSwitch_ExitOnTransparent_Hint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BgSurface0}" />

                    <!-- Rules section: new-rule editor + existing rule list + live status. -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [Settings_AutoSwitch_SectionRules], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />

                        <!-- New-rule editor. MaxLength caps the textbox so a
                             paste-bomb can't bloat settings.json. The Pick…
                             button opens a flyout listing running processes
                             (refreshed on each open via code-behind). -->
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4,0,0">
                        <TextBox Grid.Column="0"
                                 Watermark="{Binding [Settings_AutoSwitch_ProcessMatch], Source={StaticResource Loc}}"
                                 Text="{Binding NewRuleProcessMatch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200"
                                 VerticalAlignment="Center" />
                        <Button x:Name="PickProcessButton" Grid.Column="1" Margin="8,0,0,0"
                                Content="{Binding [Settings_AutoSwitch_PickProcess], Source={StaticResource Loc}}">
                            <Button.Flyout>
                                <Flyout Placement="Bottom" Opening="OnPickProcessFlyoutOpening">
                                    <Grid Width="260" Height="320" RowDefinitions="Auto,*">
                                        <TextBox Grid.Row="0" Margin="0,0,0,4"
                                                 Watermark="{Binding [Settings_AutoSwitch_PickProcessFilter], Source={StaticResource Loc}}"
                                                 Text="{Binding ProcessFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ListBox Grid.Row="1"
                                                 x:Name="ProcessPickerList"
                                                 ItemsSource="{Binding RunningProcessNames}"
                                                 IsVisible="{Binding HasRunningProcesses}"
                                                 SelectionChanged="OnProcessPickerSelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Padding="4,2" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding [Settings_AutoSwitch_PickProcessEmpty], Source={StaticResource Loc}}"
                                                   Foreground="{StaticResource TextMuted}" FontStyle="Italic"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding !HasRunningProcesses}" />
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <ComboBox Grid.Column="2" Margin="8,0,0,0" MinWidth="160"
                                  ItemsSource="{Binding MainViewModel.Layers}"
                                  SelectedItem="{Binding NewRuleLayer, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LayerViewModel">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="3" Margin="8,0,0,0"
                                Content="{Binding [Settings_AutoSwitch_Add], Source={StaticResource Loc}}"
                                Command="{Binding AddAppLayerRuleCommand}" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource BgSurface0}" Margin="0,4" />

                    <!-- Empty-state hint -->
                    <TextBlock Text="{Binding [Settings_AutoSwitch_Empty], Source={StaticResource Loc}}"
                               Foreground="{StaticResource TextMuted}" FontSize="12" FontStyle="Italic"
                               IsVisible="{Binding HasNoEditingRules}" />

                    <!-- Existing rules. Each row's DataContext is the underlying
                         AppLayerRule record; the layer label is computed via a
                         multi-converter against MainViewModel.Layers (with Count
                         as a re-evaluation trigger on keymap reload). Commands
                         live on the SettingsViewModel (the window's DataContext)
                         so we reach them via ElementName binding — the
                         (vm:T)DataContext cast pattern is unreliable inside
                         deferred templates (see CLAUDE.md). -->
                    <ItemsControl ItemsSource="{Binding EditingRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,200,Auto,Auto,Auto" Margin="0,3,0,3">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ProcessMatch}"
                                               Foreground="{StaticResource Text}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Foreground="{StaticResource TextSubtle}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource AppLayerRuleLabel}">
                                                <Binding Path="LayerIndex" />
                                                <Binding Path="DataContext.MainViewModel.Layers" ElementName="SettingsRoot" />
                                                <Binding Path="DataContext.MainViewModel.Layers.Count" ElementName="SettingsRoot" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Button Grid.Column="2" Content="▲" Padding="6,2" MinWidth="0"
                                            ToolTip.Tip="{Binding [Settings_AutoSwitch_MoveUp], Source={StaticResource Loc}}"
                                            Command="{Binding DataContext.MoveAppLayerRuleUpCommand, ElementName=SettingsRoot}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Content="▼" Padding="6,2" MinWidth="0" Margin="2,0,0,0"
                                            ToolTip.Tip="{Binding [Settings_AutoSwitch_MoveDown], Source={StaticResource Loc}}"
                                            Command="{Binding DataContext.MoveAppLayerRuleDownCommand, ElementName=SettingsRoot}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="4" Margin="8,0,0,0"
                                            ToolTip.Tip="{Binding [Settings_AutoSwitch_Remove], Source={StaticResource Loc}}"
                                            Command="{Binding DataContext.RemoveAppLayerRuleCommand, ElementName=SettingsRoot}"
                                            CommandParameter="{Binding}">
                                        <i:Icon Value="fa-solid fa-trash-can" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                        <Border Height="1" Background="{StaticResource BgSurface0}" Margin="0,4" />

                        <TextBlock Text="{Binding WouldFireText}"
                                   Foreground="{StaticResource AccentGreen}" FontSize="12" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </TabItem>


        <!-- Mouse layer tab: per-keyboard mouse-movement layer push. Like
             Auto-switch, this writes to the firmware over Raw HID, so the
             tab is gated on IsHidSourceActive — there's no value in
             configuring a push target when nothing can receive it. -->
        <TabItem Header="{Binding [Settings_Tab_MouseLayer], Source={StaticResource Loc}}"
                 IsVisible="{Binding MainViewModel.IsHidSourceActive}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" Spacing="12">

                    <TextBlock Text="{Binding [Settings_MouseLayer_Title], Source={StaticResource Loc}}"
                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock Text="{Binding [Settings_MouseLayer_Hint], Source={StaticResource Loc}}"
                               Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />

                    <CheckBox Content="{Binding [Settings_MouseLayer_Enable], Source={StaticResource Loc}}"
                              IsChecked="{Binding IsMouseLayerEnabled, Mode=TwoWay}"
                              Foreground="{StaticResource Text}"
                              Margin="0,4,0,0" />

                    <!-- Layer-while-moving picker. Disabled when the engine is off
                         (no point picking a target when nothing will fire). -->
                    <StackPanel Spacing="4" Margin="0,4,0,0"
                                IsEnabled="{Binding IsMouseLayerEnabled}">
                        <TextBlock Text="{Binding [Settings_MouseLayer_Layer], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource Text}" FontSize="12" />
                        <ComboBox MinWidth="200" HorizontalAlignment="Left"
                                  ItemsSource="{Binding MainViewModel.Layers}"
                                  SelectedItem="{Binding SelectedMouseLayer, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LayerViewModel">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Idle-timeout slider, 200–2000 ms; numeric readout to the right.
                         Disabled when Endless is checked — the value is preserved so
                         toggling endless off restores the previous timeout. -->
                    <StackPanel Spacing="4" Margin="0,4,0,0"
                                IsEnabled="{Binding IsMouseLayerEnabled}">
                        <TextBlock Text="{Binding [Settings_MouseLayer_IdleTimeout], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource Text}" FontSize="12" />
                        <Grid ColumnDefinitions="*,Auto"
                              IsEnabled="{Binding IsMouseLayerIdleTimeoutEnabled}">
                            <Slider Grid.Column="0"
                                    Minimum="200" Maximum="2000"
                                    TickFrequency="50"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding MouseLayerIdleTimeoutMs, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MouseLayerIdleTimeoutMs}"
                                       Foreground="{StaticResource Text}"
                                       MinWidth="44"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <CheckBox Content="{Binding [Settings_MouseLayer_EndlessTimeout], Source={StaticResource Loc}}"
                                  IsChecked="{Binding IsMouseLayerEndlessTimeout, Mode=TwoWay}"
                                  Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_MouseLayer_EndlessTimeout_Hint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Transparent (&trans) and empty (&none) keypress
                         exits — independent per-flag opt-ins. When endless
                         timeout is on the SettingsViewModel guarantees ≥1
                         remains enabled. -->
                    <StackPanel Spacing="4" Margin="0,8,0,0"
                                IsEnabled="{Binding IsMouseLayerEnabled}">
                        <CheckBox Content="{Binding [Settings_MouseLayer_ExitOnTransparent], Source={StaticResource Loc}}"
                                  IsChecked="{Binding IsMouseLayerExitOnTransparentKey, Mode=TwoWay}"
                                  Foreground="{StaticResource Text}" />
                        <CheckBox Content="{Binding [Settings_MouseLayer_ExitOnEmpty], Source={StaticResource Loc}}"
                                  IsChecked="{Binding IsMouseLayerExitOnEmptyKey, Mode=TwoWay}"
                                  Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_MouseLayer_ExitOnTransparent_Hint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Device routing tab: cross-device capability bus. Gated on
             IsHidSourceActive — the bus + router only discover while live
             tracking is on, so there's no inventory to show until then. -->
        <TabItem Header="{Binding [Settings_Tab_DeviceRouting], Source={StaticResource Loc}}"
                 IsVisible="{Binding MainViewModel.IsHidSourceActive}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" Spacing="16">

                    <!-- Master opt-in + availability status. -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [Settings_DeviceRouting_SectionMaster], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_DeviceRouting_Hint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                        <CheckBox Content="{Binding [Settings_DeviceRouting_Enable], Source={StaticResource Loc}}"
                                  IsChecked="{Binding DeviceRouting.RoutingEnabled, Mode=TwoWay}"
                                  Foreground="{StaticResource Text}"
                                  Margin="0,4,0,0" />
                        <!-- Lights up (green) as soon as one device speaks the
                             protocol; muted until then. -->
                        <TextBlock Text="{Binding DeviceRouting.RoutingStatus}"
                                   Foreground="{StaticResource AccentGreen}" FontSize="12" TextWrapping="Wrap"
                                   IsVisible="{Binding DeviceRouting.HasCapableDevice}" />
                        <TextBlock Text="{Binding [Settings_DeviceRouting_NoProtocol], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"
                                   IsVisible="{Binding DeviceRouting.HasNoCapableDevice}" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BgSurface0}" />

                    <!-- Discovered devices + their capability surface. -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [Settings_DeviceRouting_SectionDevices], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_DeviceRouting_NoDevices], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                                   IsVisible="{Binding DeviceRouting.HasNoDevices}" />
                        <ItemsControl ItemsSource="{Binding DeviceRouting.Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoutedDeviceRow">
                                    <Border Margin="0,3,0,3" Padding="8" CornerRadius="4"
                                            Background="{StaticResource BgSurface0}">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                                <Border Background="{StaticResource BgSurface1}" CornerRadius="3"
                                                        Padding="4,0" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsKeyboard}">
                                                    <TextBlock Text="{Binding [Settings_DeviceRouting_KeyboardBadge], Source={StaticResource Loc}}"
                                                               Foreground="{StaticResource TextSubtle}" FontSize="10" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding [Settings_DeviceRouting_NoManifest], Source={StaticResource Loc}}"
                                                       Foreground="{StaticResource TextMuted}" FontSize="12" FontStyle="Italic"
                                                       IsVisible="{Binding !HasManifest}" />
                                            <Grid ColumnDefinitions="64,*" IsVisible="{Binding HasManifest}">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding [Settings_DeviceRouting_Triggers], Source={StaticResource Loc}}"
                                                           Foreground="{StaticResource TextMuted}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding Triggers}"
                                                           Foreground="{StaticResource TextSubtle}" FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                            <Grid ColumnDefinitions="64,*" IsVisible="{Binding HasManifest}">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding [Settings_DeviceRouting_Handles], Source={StaticResource Loc}}"
                                                           Foreground="{StaticResource TextMuted}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding Handles}"
                                                           Foreground="{StaticResource TextSubtle}" FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BgSurface0}" />

                    <!-- Routing table: per (source, capability) group, an
                         enable/disable checkbox per candidate handler. -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [Settings_DeviceRouting_SectionRoutes], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_DeviceRouting_NoRoutes], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                                   IsVisible="{Binding DeviceRouting.HasNoRoutes}" />
                        <ItemsControl ItemsSource="{Binding DeviceRouting.Routes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RouteRow">
                                    <StackPanel Spacing="2" Margin="0,3,0,6">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding Handlers}" Margin="12,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RouteHandlerRow">
                                                    <CheckBox Content="{Binding DisplayName}"
                                                              IsChecked="{Binding Routed, Mode=TwoWay}"
                                                              Foreground="{StaticResource Text}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BgSurface0}" />

                    <!-- App-originated control: have LViz send an action to a
                         device directly (advanced / handler testing). -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [Settings_DeviceRouting_SectionControl], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding [Settings_DeviceRouting_ControlHint], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock Text="{Binding [Settings_DeviceRouting_ControlTarget], Source={StaticResource Loc}}"
                                       Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox MinWidth="200"
                                      ItemsSource="{Binding DeviceRouting.Devices}"
                                      SelectedItem="{Binding DeviceRouting.ControlTarget, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoutedDeviceRow">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Prompt until a target is chosen. -->
                        <TextBlock Text="{Binding [Settings_DeviceRouting_ControlPickTarget], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                                   IsVisible="{Binding DeviceRouting.NoTargetSelected}" />

                        <!-- Pointing actions the target handles — one row each. -->
                        <ItemsControl ItemsSource="{Binding DeviceRouting.PointingControls}"
                                      IsVisible="{Binding DeviceRouting.HasPointingControls}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PointingControlRow">
                                    <Grid ColumnDefinitions="120,140,Auto" ColumnSpacing="8" Margin="0,3,0,0">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" />
                                        <!-- Toggle actions (snipe, drag-scroll): on/off checkbox. -->
                                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                  IsVisible="{Binding IsToggle}"
                                                  IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                  Content="{Binding [Settings_DeviceRouting_On], Source={StaticResource Loc}}" />
                                        <!-- Count / index actions (DPI, DPI index): numeric field. -->
                                        <NumericUpDown Grid.Column="1"
                                                       IsVisible="{Binding IsNumeric}"
                                                       Minimum="0" Maximum="2147483647" Increment="1" FormatString="0"
                                                       Value="{Binding Value, Mode=TwoWay}" />
                                        <Button Grid.Column="2"
                                                Content="{Binding [Settings_DeviceRouting_Send], Source={StaticResource Loc}}"
                                                Command="{Binding SendCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- RGB (core.rgb.set): a single multi-field editor with
                             its own send logic. Each field has an Include toggle
                             (left) gating its value (right); only included fields
                             are sent, honouring the wire presence mask. -->
                        <StackPanel Spacing="3" Margin="0,8,0,0"
                                    IsVisible="{Binding DeviceRouting.HasRgbControl}">
                            <TextBlock Text="{Binding [Settings_DeviceRouting_Rgb], Source={StaticResource Loc}}"
                                       Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" />
                            <!-- On/off -->
                            <Grid ColumnDefinitions="120,140" ColumnSpacing="8">
                                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                          Content="{Binding [Settings_DeviceRouting_RgbOn], Source={StaticResource Loc}}"
                                          IsChecked="{Binding DeviceRouting.RgbControl.IncludeOn, Mode=TwoWay}" />
                                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                          IsEnabled="{Binding DeviceRouting.RgbControl.IncludeOn}"
                                          IsChecked="{Binding DeviceRouting.RgbControl.On, Mode=TwoWay}"
                                          Content="{Binding [Settings_DeviceRouting_On], Source={StaticResource Loc}}" />
                            </Grid>
                            <!-- Colour: hue + saturation + brightness picked
                                 together (the ColorView flyout has a brightness
                                 slider); decoded to the wire HSB on send. -->
                            <Grid ColumnDefinitions="120,140" ColumnSpacing="8">
                                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                          Content="{Binding [Settings_DeviceRouting_RgbColor], Source={StaticResource Loc}}"
                                          IsChecked="{Binding DeviceRouting.RgbControl.IncludeColor, Mode=TwoWay}" />
                                <Button Grid.Column="1" Padding="3" HorizontalAlignment="Left"
                                        IsEnabled="{Binding DeviceRouting.RgbControl.IncludeColor}">
                                    <Border Width="56" Height="22" CornerRadius="3"
                                            Background="{Binding DeviceRouting.RgbControl.ColorHex, Converter={StaticResource HexToBrush}}"
                                            BorderBrush="{StaticResource BgSurface1}" BorderThickness="1" />
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <ColorView Color="{Binding DeviceRouting.RgbControl.Color, Mode=TwoWay}"
                                                       IsAlphaVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <!-- Brightness: a separate dimmer, independent of the
                                 picked colour. -->
                            <Grid ColumnDefinitions="120,140" ColumnSpacing="8">
                                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                          Content="{Binding [Settings_DeviceRouting_RgbBrightness], Source={StaticResource Loc}}"
                                          IsChecked="{Binding DeviceRouting.RgbControl.IncludeBrightness, Mode=TwoWay}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding DeviceRouting.RgbControl.IncludeBrightness}"
                                        Value="{Binding DeviceRouting.RgbControl.Brightness, Mode=TwoWay}" />
                            </Grid>
                            <!-- Effect index -->
                            <Grid ColumnDefinitions="120,140,Auto" ColumnSpacing="8">
                                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                          Content="{Binding [Settings_DeviceRouting_RgbEffect], Source={StaticResource Loc}}"
                                          IsChecked="{Binding DeviceRouting.RgbControl.IncludeEffect, Mode=TwoWay}" />
                                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="255" Increment="1" FormatString="0"
                                               IsEnabled="{Binding DeviceRouting.RgbControl.IncludeEffect}"
                                               Value="{Binding DeviceRouting.RgbControl.Effect, Mode=TwoWay}" />
                                <Button Grid.Column="2" VerticalAlignment="Center"
                                        Content="{Binding [Settings_DeviceRouting_Send], Source={StaticResource Loc}}"
                                        Command="{Binding DeviceRouting.RgbControl.SendCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Layer actions: a shared layer index + only the
                             buttons the target advertises handling. -->
                        <Grid ColumnDefinitions="120,140,*" ColumnSpacing="8" Margin="0,8,0,0"
                              IsVisible="{Binding DeviceRouting.HasLayerControls}">
                            <TextBlock Grid.Column="0" Text="{Binding [Settings_DeviceRouting_Layer], Source={StaticResource Loc}}"
                                       Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1"
                                           Minimum="0" Maximum="255" Increment="1" FormatString="0"
                                           Value="{Binding DeviceRouting.ControlLayerIndex, Mode=TwoWay}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                <Button Content="{Binding [Settings_DeviceRouting_SetBase], Source={StaticResource Loc}}"
                                        Command="{Binding DeviceRouting.SetBaseLayerCommand}"
                                        IsVisible="{Binding DeviceRouting.CanSetBase}" />
                                <Button Content="{Binding [Settings_DeviceRouting_Activate], Source={StaticResource Loc}}"
                                        Command="{Binding DeviceRouting.ActivateLayerCommand}"
                                        IsVisible="{Binding DeviceRouting.CanActivate}" />
                                <Button Content="{Binding [Settings_DeviceRouting_Deactivate], Source={StaticResource Loc}}"
                                        Command="{Binding DeviceRouting.DeactivateLayerCommand}"
                                        IsVisible="{Binding DeviceRouting.CanDeactivate}" />
                            </StackPanel>
                        </Grid>

                        <!-- Target selected, but nothing LViz can originate. -->
                        <TextBlock Text="{Binding [Settings_DeviceRouting_ControlNone], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                                   IsVisible="{Binding DeviceRouting.ShowControlPlaceholder}" />

                        <TextBlock Text="{Binding DeviceRouting.ControlStatus}"
                                   Foreground="{StaticResource AccentGreen}" FontSize="12" TextWrapping="Wrap"
                                   IsVisible="{Binding DeviceRouting.ControlStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Action Pipelines tab: author named step pipelines + bind signals to
             them. Gated on a live HID source (same as Device Routing) since the
             device-step targets come from the capability router. -->
        <TabItem Header="{Binding [Settings_Tab_ActionPipelines], Source={StaticResource Loc}}"
                 IsVisible="{Binding MainViewModel.IsHidSourceActive}">
            <!-- Three sub-tabs: the pipeline library, plus the two trigger-binding
                 tables (signal id / host event id) that reference it. Same VM
                 (ActionPipelines); split only for navigation. -->
            <TabControl>

                <!-- Pipeline library: compact click-to-edit cards. Creating and
                     editing a pipeline happens in the EditPipelineDialog popup
                     (launched from code-behind via OnNewPipelineClick /
                     OnEditPipelineClick), keeping the tab a lightweight overview. -->
                <TabItem Header="{Binding [Settings_Pipeline_SectionLibrary], Source={StaticResource Loc}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{Binding [Settings_Pipeline_Hint], Source={StaticResource Loc}}"
                                           Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                                <Button Grid.Column="1" VerticalAlignment="Top"
                                        Content="{Binding [Settings_Pipeline_New], Source={StaticResource Loc}}"
                                        Click="OnNewPipelineClick" />
                            </Grid>

                            <TextBlock Text="{Binding [Settings_Pipeline_Empty], Source={StaticResource Loc}}"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" FontStyle="Italic"
                                       IsVisible="{Binding ActionPipelines.HasNoPipelines}" />

                            <ItemsControl ItemsSource="{Binding ActionPipelines.Pipelines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PipelineEditRow">
                                        <!-- Compact one-line card: name only. The step
                                             summary moves to the tooltip to save vertical
                                             space; the body text was the EditHint. -->
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Margin="0,2,0,2" Padding="10,5"
                                                Background="{StaticResource BgSurface0}"
                                                Tag="{Binding}" Click="OnEditPipelineClick"
                                                ToolTip.Tip="{Binding Summary}">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text}" FontSize="13" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Signal bindings: id → pipeline. -->
                <TabItem Header="{Binding [Settings_Pipeline_SectionBindings], Source={StaticResource Loc}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" Spacing="6">
                            <TextBlock Text="{Binding [Settings_Pipeline_BindingsHint], Source={StaticResource Loc}}"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="Auto,120,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{Binding [Settings_Pipeline_SignalId], Source={StaticResource Loc}}"
                                           Foreground="{StaticResource Text}" FontSize="12" />
                                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="255" Increment="1" FormatString="0"
                                               Value="{Binding ActionPipelines.NewBindingSignalId, Mode=TwoWay}" />
                                <Button Grid.Column="2"
                                        Content="{Binding [Settings_Pipeline_AddBinding], Source={StaticResource Loc}}"
                                        Command="{Binding ActionPipelines.AddBindingCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding [Settings_Pipeline_NoBindings], Source={StaticResource Loc}}"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" FontStyle="Italic"
                                       IsVisible="{Binding ActionPipelines.HasNoBindings}" />

                            <ItemsControl ItemsSource="{Binding ActionPipelines.SignalBindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SignalBindingRow">
                                        <Grid ColumnDefinitions="Auto,170,Auto,120,*,Auto" ColumnSpacing="8" Margin="0,3,0,3">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                       Text="{Binding [Settings_Pipeline_SourceDevice], Source={StaticResource Loc}}"
                                                       Foreground="{StaticResource TextMuted}" FontSize="12" />
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                      ItemsSource="{Binding DeviceOptions}"
                                                      SelectedItem="{Binding SelectedSourceDevice, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PipelineTargetOption">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                       Text="{Binding [Settings_Pipeline_SignalId], Source={StaticResource Loc}}"
                                                       Foreground="{StaticResource TextMuted}" FontSize="12" />
                                            <NumericUpDown Grid.Column="3" Minimum="0" Maximum="255" Increment="1" FormatString="0"
                                                           Value="{Binding SignalId, Mode=TwoWay}" />
                                            <ComboBox Grid.Column="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                      ItemsSource="{Binding PipelineNames}"
                                                      SelectedItem="{Binding PipelineName, Mode=TwoWay}" />
                                            <Button Grid.Column="5"
                                                    ToolTip.Tip="{Binding [Settings_Pipeline_Remove], Source={StaticResource Loc}}"
                                                    Command="{Binding DataContext.ActionPipelines.RemoveBindingCommand, ElementName=SettingsRoot}"
                                                    CommandParameter="{Binding}">
                                                <i:Icon Value="fa-solid fa-trash-can" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Event bindings: host event id (string) → pipeline. The CLI
                     ('lviz event <id>') fires these over IPC; same pipeline
                     library as the signal bindings, keyed by string. -->
                <TabItem Header="{Binding [Settings_Pipeline_SectionEventBindings], Source={StaticResource Loc}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" Spacing="6">
                            <TextBlock Text="{Binding [Settings_Pipeline_EventBindingsHint], Source={StaticResource Loc}}"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="Auto,160,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{Binding [Settings_Pipeline_EventId], Source={StaticResource Loc}}"
                                           Foreground="{StaticResource Text}" FontSize="12" />
                                <TextBox Grid.Column="1" Watermark="ci:ok"
                                         Text="{Binding ActionPipelines.NewBindingEventId, Mode=TwoWay}" />
                                <Button Grid.Column="2"
                                        Content="{Binding [Settings_Pipeline_AddBinding], Source={StaticResource Loc}}"
                                        Command="{Binding ActionPipelines.AddEventBindingCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding [Settings_Pipeline_NoEventBindings], Source={StaticResource Loc}}"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" FontStyle="Italic"
                                       IsVisible="{Binding ActionPipelines.HasNoEventBindings}" />

                            <ItemsControl ItemsSource="{Binding ActionPipelines.EventBindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EventBindingRow">
                                        <Grid ColumnDefinitions="Auto,140,*,Auto" ColumnSpacing="8" Margin="0,3,0,3">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                       Text="{Binding [Settings_Pipeline_EventId], Source={StaticResource Loc}}"
                                                       Foreground="{StaticResource TextMuted}" FontSize="12" />
                                            <TextBox Grid.Column="1" Watermark="ci:ok"
                                                     Text="{Binding EventId, Mode=TwoWay}" />
                                            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                      ItemsSource="{Binding PipelineNames}"
                                                      SelectedItem="{Binding PipelineName, Mode=TwoWay}" />
                                            <Button Grid.Column="3"
                                                    ToolTip.Tip="{Binding [Settings_Pipeline_Remove], Source={StaticResource Loc}}"
                                                    Command="{Binding DataContext.ActionPipelines.RemoveEventBindingCommand, ElementName=SettingsRoot}"
                                                    CommandParameter="{Binding}">
                                                <i:Icon Value="fa-solid fa-trash-can" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- App-layer bindings: an app-focus auto-switch lifecycle moment
                     (enter/leave/exit/re-enter) → pipeline. Runs alongside the
                     layer push the auto-switch engine already performs; an empty
                     process filter fires for any rule-matched app. -->
                <TabItem Header="{Binding [Settings_Pipeline_SectionAppLayerBindings], Source={StaticResource Loc}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" Spacing="6">
                            <TextBlock Text="{Binding [Settings_Pipeline_AppLayerBindingsHint], Source={StaticResource Loc}}"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />

                            <Button HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Content="{Binding [Settings_Pipeline_AddBinding], Source={StaticResource Loc}}"
                                    Command="{Binding ActionPipelines.AddAppLayerBindingCommand}" />

                            <TextBlock Text="{Binding [Settings_Pipeline_NoAppLayerBindings], Source={StaticResource Loc}}"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" FontStyle="Italic"
                                       IsVisible="{Binding ActionPipelines.HasNoAppLayerBindings}" />

                            <ItemsControl ItemsSource="{Binding ActionPipelines.AppLayerBindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppLayerBindingRow">
                                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,3,0,3">
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                      ItemsSource="{Binding AvailableTriggers}"
                                                      SelectedItem="{Binding SelectedTrigger, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AppLayerTriggerOption">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                      ItemsSource="{Binding PipelineNames}"
                                                      SelectedItem="{Binding PipelineName, Mode=TwoWay}" />
                                            <Button Grid.Column="2"
                                                    ToolTip.Tip="{Binding [Settings_Pipeline_Remove], Source={StaticResource Loc}}"
                                                    Command="{Binding DataContext.ActionPipelines.RemoveAppLayerBindingCommand, ElementName=SettingsRoot}"
                                                    CommandParameter="{Binding}">
                                                <i:Icon Value="fa-solid fa-trash-can" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </TabItem>

        <!-- Testing tab: temporary scratch area for HID push tests. Remove when done. -->
        <TabItem Header="Testing" IsVisible="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" Spacing="12">
                    <TextBlock Text="Push layer to keyboard"
                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock Text="Selecting a layer fires SetLayerStateAsync immediately. See log for app push acknowledged / external change events."
                               Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox MinWidth="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding MainViewModel.Layers}"
                              SelectedItem="{Binding SelectedTestLayer, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LayerViewModel">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Separator Margin="0,8" />

                    <TextBlock Text="HID queries (shared module)"
                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock Text="Sends 0xFD GetDeviceInfo / 0xFB GetConfigId and waits up to 1s for the matching reply."
                               Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0" ColumnSpacing="8" RowSpacing="6">
                        <Button Grid.Row="0" Grid.Column="0"
                                Content="Query device info"
                                HorizontalAlignment="Stretch"
                                Command="{Binding QueryDeviceInfoCommand}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding DeviceInfoResult}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text}"
                                   TextWrapping="Wrap" />
                        <Button Grid.Row="1" Grid.Column="0"
                                Content="Query config ID"
                                HorizontalAlignment="Stretch"
                                Command="{Binding QueryConfigIdCommand}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding ConfigIdResult}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Separator Margin="0,8" />

                    <TextBlock Text="Active window (focus follows OS)"
                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock Text="Updates within ~500 ms of focus change. WindowTitle is null on macOS by design (no Accessibility entitlement)."
                               Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ProcessName" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MainViewModel.AutoSwitch.ActiveWindow.ProcessName, FallbackValue='(none)', TargetNullValue='(none)'}" Foreground="{StaticResource Text}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="BundleId" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MainViewModel.AutoSwitch.ActiveWindow.BundleId, FallbackValue='(none)', TargetNullValue='(none)'}" Foreground="{StaticResource Text}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="WindowTitle" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MainViewModel.AutoSwitch.ActiveWindow.WindowTitle, FallbackValue='(none)', TargetNullValue='(none)'}" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        </TabControl>

    </DockPanel>

</Window>
