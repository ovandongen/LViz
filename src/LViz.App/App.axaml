<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:LViz.App.Localization"
             x:Class="LViz.App.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <!-- Compact numeric steppers app-wide. Fluent's default NumericUpDown is
             tall, and a MinHeight floor alone doesn't tame it (a disabled stepper
             still renders at the theme's tall default). Pin an explicit Height so
             every stepper — enabled or disabled — is a consistent 28px, then trim
             the inner spinner/text box/repeat buttons to fit. The text box and
             repeat buttons are reached via /template/ so this only touches
             NumericUpDown internals, not standalone TextBoxes or scrollbars. -->
        <Style Selector="NumericUpDown">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner">
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ButtonSpinner /template/ RepeatButton">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <!-- Compact input controls app-wide (lifted from the pipeline editor).
             Fluent's defaults are tall and the text rides high; trim the heights,
             shrink the font, and centre content. Type selectors match the exact
             type only, so these don't reach the spinner RepeatButtons or ComboBox
             toggle internals. Controls that set these properties inline keep their
             own values (a local value wins over a style setter). -->
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Primary dialog button (Classes="accent": Save / OK). Fluent paints
             hover and pressed on the template's ContentPresenter, so those
             states are overridden there; disabled keeps Fluent's grey look.
             DynamicResource: the palette below is loaded after these styles. -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}" />
            <Setter Property="Foreground" Value="{DynamicResource BgBase}" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}" />
            <Setter Property="Foreground" Value="{DynamicResource BgBase}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}" />
            <Setter Property="Foreground" Value="{DynamicResource BgBase}" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <!-- Button on an AccentBlue surface (Classes="onAccent": the edit
             banner). Fluent's default white-on-light text doesn't read there, so
             it follows the accent rule: dark BgBase text with a BgBase outline,
             inverting to a dark fill with accent text on hover. Add "primary"
             for the banner's main action, which is dark from the start. -->
        <Style Selector="Button.onAccent">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BgBase}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgBase}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.onAccent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgBase}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgBase}" />
        </Style>
        <Style Selector="Button.onAccent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgBase}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgBase}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.onAccent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BgBase}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgBase}" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- A PathIcon doesn't pick up the button's Foreground (Fluent gives
             icons their own), so the banner's undo/redo icons follow it here. -->
        <Style Selector="Button.onAccent PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BgBase}" />
        </Style>
        <Style Selector="Button.onAccent:pointerover PathIcon, Button.onAccent:pressed PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}" />
        </Style>
        <Style Selector="Button.onAccent:disabled PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BgBase}" />
        </Style>
        <Style Selector="Button.onAccent.primary">
            <Setter Property="Background" Value="{DynamicResource BgBase}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}" />
        </Style>
        <Style Selector="Button.onAccent.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.onAccent.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgBase}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}" />
        </Style>

        <!-- Text link styled as a button (Classes="link"): no background or
             border in any state, accent text that brightens on hover. -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>

        <!-- Trim the CheckBox / RadioButton glyphs (Fluent defaults are 20px,
             which looks heavy next to the 12px text). Part names are from the
             Fluent control templates; the checkbox box and the radio rings shrink
             to 16px, the radio's inner dot from 8 to 6. -->
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="RadioButton /template/ Ellipse#OuterEllipse">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="RadioButton /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="RadioButton /template/ Ellipse#CheckGlyph">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <loc:Loc x:Key="Loc" />

        <!-- App-wide color palette. Mirror of LViz.App.Services.AppTheme;
             keep both in sync. Rule of thumb: any literal #RRGGBB in a view file
             is a bug — add it here (and in AppTheme) and reference via
             {StaticResource <name>} instead. -->

        <!-- Backgrounds -->
        <SolidColorBrush x:Key="BgCrust" Color="#181825" />
        <SolidColorBrush x:Key="BgBase" Color="#1E1E2E" />
        <SolidColorBrush x:Key="BgSurface0" Color="#313244" />
        <SolidColorBrush x:Key="BgSurface1" Color="#45475A" />

        <!-- Text -->
        <SolidColorBrush x:Key="Text" Color="#CDD6F4" />
        <SolidColorBrush x:Key="TextSubtle" Color="#A6ADC8" />
        <SolidColorBrush x:Key="TextMuted" Color="#6C7086" />
        <SolidColorBrush x:Key="TextStatusBar" Color="#8A8AA0" />
        <SolidColorBrush x:Key="TextAccessibilityBody" Color="#D0D0D8" />

        <!-- Accents -->
        <SolidColorBrush x:Key="AccentBlue" Color="#89B4FA" />
        <SolidColorBrush x:Key="AccentGreen" Color="#A6E3A1" />
        <SolidColorBrush x:Key="AccentTeal" Color="#94E2D5" />
        <SolidColorBrush x:Key="AccentYellow" Color="#F9E2AF" />
        <SolidColorBrush x:Key="AccentRed" Color="#F38BA8" />

        <!-- Tab chrome -->
        <SolidColorBrush x:Key="TabBg" Color="#363649" />
        <SolidColorBrush x:Key="TabBorder" Color="#4A4A63" />
        <SolidColorBrush x:Key="TabHoverBg" Color="#3E3E5C" />
        <SolidColorBrush x:Key="TabHoverBorder" Color="#6A6A88" />
        <SolidColorBrush x:Key="TabSelectedBg" Color="#46466A" />
        <SolidColorBrush x:Key="TabSelectedBorder" Color="#7A7A9A" />

        <!-- Key board -->
        <SolidColorBrush x:Key="KeyDefaultFill" Color="#F2F2F2" />
        <SolidColorBrush x:Key="KeyStroke" Color="#B0B0B0" />
        <SolidColorBrush x:Key="KeyLayerFill" Color="#1F8B4C" />

        <!-- Combo indicator -->
        <SolidColorBrush x:Key="ComboFill" Color="#4DABF7" />
        <SolidColorBrush x:Key="ComboStroke" Color="#1971C2" />

        <!-- Error toast -->
        <SolidColorBrush x:Key="ErrorBg" Color="#E03131" />
        <SolidColorBrush x:Key="ErrorBorder" Color="#A51F1F" />
        <SolidColorBrush x:Key="ErrorText" Color="#FFFFFF" />
    </Application.Resources>

    <!-- System tray icon (NativeMenuItem doesn't support binding — localized in code-behind) -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon ToolTipText="LViz">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show Layers" Command="{Binding ShowCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit" Command="{Binding QuitCommand}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
