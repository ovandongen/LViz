/*
 * Slabwing keymap (QWERTY starter layout - adjust to taste).
 * Key order follows the physical layout (see the matrix transform in slabwing.overlay):
 *
 *          k0   k1   k2   k3   k4          k5   k6   k7   k8   k9
 *     k10  k11  k12  k13  k14  k15         k16  k17  k18  k19  k20  k21
 *     k22  k23  k24  k25  k26  k27         k28  k29  k30  k31  k32  k33
 *     k34  k35  k36  k37  k38  k39         k40  k41  k42  k43  k44  k45
 *               k46  k47                             k48  k49
 *                     k50  k51  k52      k53  k54  k55
 *               (thumbs: outer mid inner | inner mid outer)
 *
 * Layers: BASE, NAV (left mid thumb), SYM (right mid thumb), ADJ (NAV+SYM: Bluetooth, bootloader).
 * The original matrix test keymap is kept in tests/slabwing_matrix_test.keymap.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <2 2>;
            then-layer = <2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // safety net: always reachable, even if a layer is broken

        combo_bootloader {
            timeout-ms = <80>;
            key-positions = <1 2 12>;
            bindings = <&bootloader>;
        };

        mouse-mid {
            bindings = <&mkp MCLK>;
            key-positions = <46 47>;
        };

        f12 {
            bindings = <&kp F12>;
            key-positions = <0 1>;
        };

        syslayer {
            bindings = <&mo 2>;
            key-positions = <53 52>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&mt F1 NUMBER_1  &mt F2 NUMBER_2  &mt F3 NUMBER_3  &mt F4 NUMBER_4  &mt F5 N5  &mt F6 NUMBER_6  &mt F7 N7       &mt F8 N8   &mt F9 N9  &mt F10 N0
&kp ESCAPE       &kp Q            &kp W            &kp E            &kp R      &kp T            &kp Y           &kp U       &kp I      &kp O       &kp P     &kp BACKSLASH
&kp TAB          &kp A            &kp S            &kp D            &lt 6 F    &kp G            &kp H           &lt 3 J     &lt 4 K    &lt 5 L     &kp SEMI  &kp PAGE_UP
&caps_word       &mt LEFT_ALT Z   &kp X            &kp C            &kp V      &kp B            &kp N           &kp M       &kp COMMA  &kp DOT     &kp FSLH  &kp PAGE_DOWN
&mkp LCLK        &mkp RCLK        &kp UP_ARROW     &kp DOWN_ARROW   &kp LCTRL  &lt 1 ENTER      &kp LEFT_SHIFT  &kp DELETE  &kp SPACE  &kp BSPC
            >;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
&kp LS(AMPS)  &kp LBKT       &kp LS(PIPE)  &kp RBKT      &kp LS(EXCL)  &kp DOT        &kp LS(LBRC)  &kp LS(PRCNT)  &kp LS(RBRC)   &kp LS(STAR)
&trans        &kp LS(POUND)  &kp LS(LBRC)  &kp LS(PLUS)  &kp LS(RBRC)  &kp LS(QMARK)  &kp GRAVE     &kp LBKT       &kp LS(COLON)  &kp RBKT      &kp LS(POUND)  &trans
&trans        &kp LS(AT)     &kp LS(LPAR)  &kp EQUAL     &kp LS(RPAR)  &kp LS(STAR)   &kp LS(DQT)   &kp LS(LT)     &kp LS(AT)     &kp LS(GT)    &kp LS(CARET)  &trans
&trans        &kp LS(DLLR)   &kp LS(LT)    &kp MINUS     &kp LS(GT)    &kp FSLH       &kp SQT       &kp LS(LPAR)   &kp LS(UNDER)  &kp LS(RPAR)  &kp LS(DLLR)   &trans
&trans        &trans         &trans        &trans        &trans        &trans         &trans        &trans         &trans         &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none   &none  &none  &none   &bootloader
&none         &bt BT_CLR    &none         &none         &none         &none   &none  &none  &none   &none        &none  &sys_reset
&none         &out OUT_USB  &out OUT_BLE  &none         &none         &none   &none  &none  &none   &none        &none  &none
&none         &none         &none         &none         &none         &none   &none  &none  &none   &none        &none  &none
&none         &none         &none         &none         &none         &trans  &none  &none  &trans  &none
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
&trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav-alt {
            display-name = "Nav-alt";
            bindings = <
&trans  &trans  &trans              &trans              &trans               &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans              &kp LA(UP_ARROW)    &trans               &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LA(LEFT_ARROW)  &kp LA(DOWN_ARROW)  &kp LA(RIGHT_ARROW)  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans              &trans              &trans               &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans              &trans              &trans               &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav-alt-shift {
            display-name = "Nav-alt-shift";
            bindings = <
&trans  &trans  &trans                  &trans                  &trans                   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                  &kp LS(LA(UP_ARROW))    &trans                   &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LS(LA(LEFT_ARROW))  &kp LS(LA(DOWN_ARROW))  &kp LS(LA(RIGHT_ARROW))  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                  &trans                  &trans                   &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                  &trans                  &trans                   &trans  &trans  &trans  &trans  &trans
            >;
        };

        numbers {
            display-name = "Numbers";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp NUMBER_6  &kp N7        &kp N8        &kp N9        &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans
            >;
        };
    };
};
