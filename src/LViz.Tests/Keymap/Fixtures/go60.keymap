     &kp LCTRL  &kp LS(N4)  &kp LS(COMMA)      &kp MINUS   &kp LS(DOT)      &kp FSLH                                                               &kp SQT     &kp LS(N9)      &kp SEMI    &kp LS(N0)  &kp LS(N4)   &kp LS(GRAVE)
                                  &kp SQT  &kp LS(MINUS)    &kp LS(N2)                                                                                           &kp BSLH    &kp LS(N7)    &kp LS(N3)
                                                                                      &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Keypad {
            bindings = <
 &to LAYER_Base     &trans     &trans     &trans     &trans         &trans                                                           &trans     &trans     &trans      &trans        &trans                &trans
         &trans  &kp LC(Y)   &kp HOME     &kp UP    &kp END      &kp PG_UP                                                     &kp KP_SLASH  &kp KP_N7  &kp KP_N8   &kp KP_N9  &kp KP_MINUS                &trans
         &trans  &kp LC(Z)   &kp LEFT   &kp DOWN  &kp RIGHT      &kp PG_DN                                                  &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5   &kp KP_N6   &kp KP_PLUS            &kp KP_NUM
         &trans     &trans  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LS(LC(V))                                                     &kp KP_EQUAL  &kp KP_N1  &kp KP_N2   &kp KP_N3     &kp EQUAL  &magic LAYER_Magic 0
                               &trans     &trans     &trans                                                                                  &kp KP_N0  &kp KP_N0  &kp KP_DOT
                                                                            &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Nav {
            bindings = <
 &trans     &trans     &trans     &trans     &trans         &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
 &trans     &trans   &kp HOME     &kp UP    &kp END      &kp PG_UP                                                  &trans  &trans  &trans  &trans  &trans  &trans
 &trans  &kp LC(Y)   &kp LEFT   &kp DOWN  &kp RIGHT      &kp PG_DN                                                  &trans  &trans  &trans  &trans  &trans  &trans
 &trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LS(LC(V))                                                  &trans  &trans  &trans  &trans  &trans  &trans
                       &trans     &trans     &trans                                                                         &trans  &trans  &trans
                                                                    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Nav_Alt {
            bindings = <
 &trans     &trans        &trans        &trans         &trans         &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
 &trans     &trans      &kp HOME    &kp LA(UP)        &kp END      &kp PG_UP                                                  &trans  &trans  &trans  &trans  &trans  &trans
 &trans  &kp LC(Y)  &kp LA(LEFT)  &kp LA(DOWN)  &kp LA(RIGHT)      &kp PG_DN                                                  &trans  &trans  &trans  &trans  &trans  &trans
 &trans  &kp LC(Z)     &kp LC(X)     &kp LC(C)      &kp LC(V)  &kp LS(LC(V))                                                  &trans  &trans  &trans  &trans  &trans  &trans
                          &trans        &trans         &trans                                                                         &trans  &trans  &trans
                                                                              &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Nav_Alt_Shift {
            bindings = <
 &trans     &trans            &trans               &trans             &trans         &trans                                                  &trans  &trans  &trans  &trans  &trans  &trans
 &trans     &trans          &kp HOME  &lt LAYER_Nav_Alt K            &kp END      &kp PG_UP                                                  &trans  &trans  &trans  &trans  &trans  &trans
 &trans  &kp LC(Y)  &kp LA(LS(LEFT))     &kp LA(LS(DOWN))  &kp LA(LS(RIGHT))      &kp PG_DN                                                  &trans  &trans  &trans  &trans  &trans  &trans
 &trans  &kp LC(Z)         &kp LC(X)            &kp LC(C)          &kp LC(V)  &kp LS(LC(V))                                                  &trans  &trans  &trans  &trans  &trans  &trans
                              &trans               &trans             &trans                                                                         &trans  &trans  &trans
                                                                                             &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Mouse_Signals {
            bindings = <
 &trans  &signal_1  &signal_2  &signal_3  &signal_4  &signal_5                                                       &trans  &trans  &trans  &trans  &trans  &trans
 &trans     &trans     &trans     &trans     &trans     &trans                                                       &trans  &trans  &trans  &trans  &trans  &trans
 &trans     &trans     &trans     &trans     &trans     &trans                                                       &trans  &trans  &trans  &trans  &trans  &trans
 &trans     &trans     &trans     &trans     &trans     &trans                                                       &trans  &trans  &trans  &trans  &trans  &trans
                       &trans     &trans     &trans                                                                          &trans  &trans  &trans
                                                                &trans  &dpi_800  &dpi_1600  &trans  &trans  &trans
            >;
        };

        layer_Magic {
            bindings = <
       &none     &kp C_BRI_DN     &kp C_BRI_UP       &kp C_PREV       &kp C_NEXT         &kp C_PP                                                          &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP   &none  &bt BT_CLR  &bt BT_CLR_ALL
 &bootloader  &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG                                                               &none         &none         &none   &none       &none     &bootloader
  &sys_reset  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF                                                               &none         &none         &none   &none       &none      &sys_reset
       &none            &none            &bt_0            &bt_1            &bt_2            &bt_3                                                               &none         &none         &none   &none       &none           &none
                                  &out OUT_USB            &none   &to LAYER_Base                                                                                              &none         &none   &none
                                                                                                   &to LAYER_Base   &none   &none   &none   &none   &none
            >;
        };

    };
};