 *
 * Cosmos 82 - hand-wired dished split, 2x nice!nano v2, Choc v1 hotswap.
 * Shared definitions for both halves.
 *
 * Physical design (Cosmos generator, source of truth for key geometry -
 * needed if ZMK Studio support is ever added):
 * https://ryanis.cool/cosmos/beta#cm:
 *
 * Matrix (identical logical assignment on both halves, mirrored physically):
 *
 *   Row   nRF pin   Pro Micro pad        Col   nRF pin   Pro Micro pad
 *   ---   -------   -------------        ---   -------   -------------
 *   R0    P0.02     D19 / A1             C0    P0.20     D3
 *   R1    P1.15     D18 / A0             C1    P0.22     D4 / A6
 *   R2    P1.13     D15                  C2    P0.24     D5
 *   R3    P1.11     D14                  C3    P1.00     D6 / A7
 *   R4    P0.10     D16   <- NFC pin     C4    P0.11     D7
 *   R5    P0.09     D10 / A10 <- NFC     C5    P1.04     D8 / A8
 *                                        C6    P1.06     D9 / A9
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * R4 (P0.10) and R5 (P0.09) are the nRF52840's NFC antenna pins and are NOT
 * usable as GPIO until NFC is released. ZMK's nice_nano_v2 board files do not
 * do this for you, so without the line below 14 keys per half - including 4 of
 * the 5 thumb keys - are silently dead.
 *
 * This writes UICR once, on the first boot after flashing. It persists across
 * reflashes and is only undone by a full UICR erase. The old
 * CONFIG_NFCT_PINS_AS_GPIOS Kconfig symbol is deprecated in Zephyr 3.5; this
 * devicetree property is the supported replacement.
 */
&uicr {
    nfct-pins-as-gpios;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        /* Driven low->high one at a time */
        col-gpios
            = <&gpio0 20 GPIO_ACTIVE_HIGH>  /* C0 - P0.20 / D3      */
            , <&gpio0 22 GPIO_ACTIVE_HIGH>  /* C1 - P0.22 / D4      */
            , <&gpio0 24 GPIO_ACTIVE_HIGH>  /* C2 - P0.24 / D5      */
            , <&gpio1  0 GPIO_ACTIVE_HIGH>  /* C3 - P1.00 / D6      */
            , <&gpio0 11 GPIO_ACTIVE_HIGH>  /* C4 - P0.11 / D7      */
            , <&gpio1  4 GPIO_ACTIVE_HIGH>  /* C5 - P1.04 / D8      */
            , <&gpio1  6 GPIO_ACTIVE_HIGH>  /* C6 - P1.06 / D9      */
            ;

        /* Read back, pulled down between scans */
        row-gpios
            = <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R0 - P0.02 / D19 */
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R1 - P1.15 / D18 */
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R2 - P1.13 / D15 */
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R3 - P1.11 / D14 */
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R4 - P0.10 / D16 */
            , <&gpio0  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R5 - P0.09 / D10 */
            ;
    };

    /*
     * Joined matrix: 6 rows x 14 columns.
     *   Left  half -> matrix columns 0..6  (col-offset 0, the default)
     *   Right half -> matrix columns 7..13 (col-offset 7, set in the overlay)
     *
     * Each half applies this transform locally and reports the resulting key
     * position, so the offset is what keeps the two halves from colliding. It
     * is independent of which half is the central.
     *
     * PHYSICAL ORDER, confirmed by the discovery pass. The map reads the way
     * you look at the board: left to right, top to bottom.
     *
     * The halves are wired identically but mounted mirrored, so the columns
     * run in OPPOSITE visual directions:
     *   left  half, left-to-right = C6 C5 C4 C3 C2 C1 C0   (C0 is innermost)
     *   right half, left-to-right = C0 C1 C2 C3 C4 C5 C6   (C0 is innermost)
     *
     * Per half: 7/7/7/7 finger keys on rows 0-3, 6 on row 4, 2 on row 5, then
     * a 5-key thumb cluster (3 upper, 2 lower) hanging off rows 4 and 5.
     * 41 keys per half, 82 total.
     *
     * RC(5,6) and its mirror RC(5,13) are the one unwired crossing per half
     * and are deliberately absent - a map may be shorter than rows x columns.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <6>;
        map = <
    //   ------------------------- LEFT (C6 -> C0) -------------------------       ------------------------ RIGHT (C0 -> C6) -------------------------
         RC(0,6)  RC(0,5)  RC(0,4)  RC(0,3)  RC(0,2)  RC(0,1)  RC(0,0)             RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13)
         RC(1,6)  RC(1,5)  RC(1,4)  RC(1,3)  RC(1,2)  RC(1,1)  RC(1,0)             RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10) RC(1,11) RC(1,12) RC(1,13)
         RC(2,6)  RC(2,5)  RC(2,4)  RC(2,3)  RC(2,2)  RC(2,1)  RC(2,0)             RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10) RC(2,11) RC(2,12) RC(2,13)
         RC(3,6)  RC(3,5)  RC(3,4)  RC(3,3)  RC(3,2)  RC(3,1)  RC(3,0)             RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10) RC(3,11) RC(3,12) RC(3,13)
                  RC(4,6)  RC(4,5)  RC(4,4)  RC(4,3)  RC(4,2)  RC(4,1)             RC(4,8)  RC(4,9)  RC(4,10) RC(4,11) RC(4,12) RC(4,13)
                                    RC(5,4)  RC(5,3)                                                 RC(5,10) RC(5,11)
    //   thumb cluster, upper row (3) then lower row (2)
                           RC(5,2)  RC(5,1)  RC(4,0)                                        RC(4,7)  RC(5,8)  RC(5,9)
                                    RC(5,5)  RC(5,0)                                        RC(5,7)  RC(5,12)
        >;
    };

    /*
     * Physical layout. The keys property below is only consumed by ZMK Studio,
     * which is NOT currently enabled - the keymap is edited with keymap-editor
     * instead, which reads config/info.json. It is kept as a native ZMK record
     * of the board's geometry; re-enabling Studio needs only the build flag and
     * a &studio_unlock binding.
     *
     * Coordinates come from the Cosmos KLE export, reordered to match the
     * transform above: per row, left half then right half, each sorted left to
     * right as you look at the board.
     *
     * Units are centi-keyunits (100 = 1u) and centi-degrees. This is a flat
     * projection of a dished 3D board, so it is a schematic of the real
     * geometry rather than a literal one. Every x/y is exactly as exported,
     * including the column stagger.
     *
     * Keycaps are drawn at 79 rather than 100. Flattening a dish genuinely
     * puts some keys closer than 1u apart - the row 0 to row 1 pitch is only
     * 90, and one diagonal pair per half is 79 apart - so at full size the top
     * two rows visibly overlapped. Shrinking the cap is the only fix that
     * distorts no positions at all; 79 is the largest value with zero overlaps.
     *
     * The 10 thumb keys are not. Flattening a dish collapses that cluster onto
     * itself, and the export has them overlapping badly enough that Studio drew
     * each key over its neighbour and two of them disappeared entirely. They
     * are spread 1.21x about each half's thumb centroid and moved 0.4u down -
     * the least distortion that clears every overlap. Splay angles (10/25/35
     * degrees, mirrored) are untouched and are the true values.
     */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  //                     w    h     x     y   rot     rx    ry
            // row 0  (7 left, 7 right)
            = <&key_physical_attrs  79   79     0    83     0      0     0>
            , <&key_physical_attrs  79   79   104    83     0      0     0>
            , <&key_physical_attrs  79   79   212    15     0      0     0>
            , <&key_physical_attrs  79   79   321     0     0      0     0>
            , <&key_physical_attrs  79   79   417    16     0      0     0>
            , <&key_physical_attrs  79   79   517    16     0      0     0>
            , <&key_physical_attrs  79   79   614    17     0      0     0>
            , <&key_physical_attrs  79   79  1304    17     0      0     0>
            , <&key_physical_attrs  79   79  1400    16     0      0     0>
            , <&key_physical_attrs  79   79  1500    16     0      0     0>
            , <&key_physical_attrs  79   79  1597     0     0      0     0>
            , <&key_physical_attrs  79   79  1706    15     0      0     0>
            , <&key_physical_attrs  79   79  1814    83     0      0     0>
            , <&key_physical_attrs  79   79  1917    83     0      0     0>
            // row 1  (7 left, 7 right)
            , <&key_physical_attrs  79   79     2   173     0      0     0>
            , <&key_physical_attrs  79   79   111   173     0      0     0>
            , <&key_physical_attrs  79   79   224   105     0      0     0>
            , <&key_physical_attrs  79   79   338    90     0      0     0>
            , <&key_physical_attrs  79   79   439   105     0      0     0>
            , <&key_physical_attrs  79   79   543   106     0      0     0>
            , <&key_physical_attrs  79   79   644   107     0      0     0>
            , <&key_physical_attrs  79   79  1273   107     0      0     0>
            , <&key_physical_attrs  79   79  1374   106     0      0     0>
            , <&key_physical_attrs  79   79  1478   105     0      0     0>
            , <&key_physical_attrs  79   79  1580    90     0      0     0>
            , <&key_physical_attrs  79   79  1694   105     0      0     0>
            , <&key_physical_attrs  79   79  1807   173     0      0     0>
            , <&key_physical_attrs  79   79  1915   173     0      0     0>
            // row 2  (7 left, 7 right)
            , <&key_physical_attrs  79   79     4   278     0      0     0>
            , <&key_physical_attrs  79   79   115   278     0      0     0>
            , <&key_physical_attrs  79   79   232   210     0      0     0>
            , <&key_physical_attrs  79   79   348   195     0      0     0>
            , <&key_physical_attrs  79   79   453   211     0      0     0>
            , <&key_physical_attrs  79   79   560   211     0      0     0>
            , <&key_physical_attrs  79   79   664   212     0      0     0>
            , <&key_physical_attrs  79   79  1254   212     0      0     0>
            , <&key_physical_attrs  79   79  1358   211     0      0     0>
            , <&key_physical_attrs  79   79  1465   211     0      0     0>
            , <&key_physical_attrs  79   79  1569   195     0      0     0>
            , <&key_physical_attrs  79   79  1686   210     0      0     0>
            , <&key_physical_attrs  79   79  1802   278     0      0     0>
            , <&key_physical_attrs  79   79  1914   278     0      0     0>
            // row 3  (7 left, 7 right)
            , <&key_physical_attrs  79   79     4   392     0      0     0>
            , <&key_physical_attrs  79   79   117   392     0      0     0>
            , <&key_physical_attrs  79   79   234   323     0      0     0>
            , <&key_physical_attrs  79   79   352   309     0      0     0>
            , <&key_physical_attrs  79   79   457   324     0      0     0>
            , <&key_physical_attrs  79   79   565   325     0      0     0>
            , <&key_physical_attrs  79   79   670   326     0      0     0>
            , <&key_physical_attrs  79   79  1247   326     0      0     0>
            , <&key_physical_attrs  79   79  1352   325     0      0     0>
            , <&key_physical_attrs  79   79  1460   324     0      0     0>
            , <&key_physical_attrs  79   79  1566   309     0      0     0>
            , <&key_physical_attrs  79   79  1683   323     0      0     0>
            , <&key_physical_attrs  79   79  1800   392     0      0     0>
            , <&key_physical_attrs  79   79  1913   392     0      0     0>
            // row 4  (6 left, 6 right)
            , <&key_physical_attrs  79   79     4   506     0      0     0>
            , <&key_physical_attrs  79   79   115   506     0      0     0>
            , <&key_physical_attrs  79   79   232   437     0      0     0>
            , <&key_physical_attrs  79   79   348   423     0      0     0>
            , <&key_physical_attrs  79   79   453   438     0      0     0>
            , <&key_physical_attrs  79   79   560   439     0      0     0>
            , <&key_physical_attrs  79   79  1358   439     0      0     0>
            , <&key_physical_attrs  79   79  1465   438     0      0     0>
            , <&key_physical_attrs  79   79  1569   423     0      0     0>
            , <&key_physical_attrs  79   79  1686   437     0      0     0>
            , <&key_physical_attrs  79   79  1802   506     0      0     0>
            , <&key_physical_attrs  79   79  1914   506     0      0     0>
            // row 5  (2 left, 2 right)
            , <&key_physical_attrs  79   79   224   544     0      0     0>
            , <&key_physical_attrs  79   79   337   529     0      0     0>
            , <&key_physical_attrs  79   79  1580   529     0      0     0>
            , <&key_physical_attrs  79   79  1694   544     0      0     0>
            // thumb upper  (3 left, 3 right)
            , <&key_physical_attrs  79   79   446   586  1000    496   636>
            , <&key_physical_attrs  79   79   570   623  2500    620   673>
            , <&key_physical_attrs  79   79   674   681  3500    724   731>
            , <&key_physical_attrs  79   79  1244   681 (-3500)   1294   731>
            , <&key_physical_attrs  79   79  1348   623 (-2500)   1398   673>
            , <&key_physical_attrs  79   79  1471   586 (-1000)   1521   636>
            // thumb lower  (2 left, 2 right)
            , <&key_physical_attrs  79   79   496   738  2500    546   788>
            , <&key_physical_attrs  79   79   598   796  3500    648   846>
            , <&key_physical_attrs  79   79  1320   796 (-3500)   1370   846>
            , <&key_physical_attrs  79   79  1422   738 (-2500)   1472   788>
            ;
    };
};

/*
 * ============================================================================
 * Stage 2 - PMW3610 trackballs (one per half, identically wired)
 * ============================================================================
 *
 *   Signal   nRF pin   Pro Micro pad
 *   ------   -------   -------------
 *   SCLK     P0.31     D21 / A3
 *   SDIO     P0.29     D20 / A2      <- 3-wire: MOSI and MISO share this pin
 *   CS       P0.06     D1
 *   MOT      P0.08     D0
 *
 * Three of the nice!nano's own peripherals claim pins we need, or pins the
 * matrix already uses. They are harmless today only because CONFIG_SPI is off;
 * enabling it for the sensor would initialise them and apply their pinctrl.
 */

/*
 * uart0 is status = "okay" on the nice!nano with TX on P0.06 and RX on P0.08 -
 * exactly our CS and MOT lines. Nothing uses it (it is not the console), so it
 * is disabled to release the pins.
 */
&uart0 {
    status = "disabled";
};

/*
 * THIS ONE MATTERS. spi1 (pro_micro_spi) is also status = "okay", and its
 * pinctrl is SCK P1.13, MOSI P0.10, MISO P1.11 - which are matrix rows R2, R4
 * and R3. With CONFIG_SPI=y it would initialise and steal three of the six
 * rows, killing half the keyboard with no error anywhere.
 */
&spi1 {
    status = "disabled";
};

/*
 * i2c0 shares a hardware instance with spi0 on the nRF52840, so the two are
 * mutually exclusive. Its default SCL is also P0.20, which is column C0.
 */
&i2c0 {
    status = "disabled";
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 31)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 29)>,
                    <NRF_PSEL(SPIM_MISO, 0, 29)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 31)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 29)>,
                    <NRF_PSEL(SPIM_MISO, 0, 29)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;   /* CS  - P0.06 / D1 */

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;

        /*
         * Required by the binding. Both sensors emit plain relative X/Y here;
         * the left half's ball is turned into scroll on the central, in
         * cosmos82_right.overlay, so this node stays identical on both halves.
         */
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        /*
         * Orientation is decided by how the sensor is physically mounted, which
         * we cannot know until it is tested. If the cursor moves along the wrong
         * axis or backwards, add swap-xy, invert-x and/or invert-y here (they
         * are devicetree properties in this driver, not Kconfig).
         *
         * force-awake / force-awake-4ms-mode are deliberately left off: they
         * keep the sensor permanently powered for lower latency, at a real cost
         * to battery life on a wireless board.
         */
    };
};

/ {
    /*
     * The LEFT half's sensor lives on the peripheral, so its events have to
     * cross the BLE link. Both halves instantiate this node: on the peripheral
     * it forwards the local sensor, on the central it receives.
     */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    /*
     * Both listeners are declared here but disabled, so either half can build
     * and the keymap can reference them without an undefined-reference error.
     * The central enables both; the peripheral enables neither.
     */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball>;
    };

    trackball_split_listener: trackball_split_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball_split>;
    };
};
