/*
 * Slabwing - hand-wired unibody split, nice!nano v2, Kailh Choc v1
 * Matrix: 5 rows x 12 columns (6 columns per half), diodes col2row
 * (diode cathode/black band away from the switch, towards the row wire).
 *
 * Wiring (nice!nano pin labels):
 *   cols 1-6  (left half, left->right):  P1.06 P1.04 P0.11 P1.00 P0.24 P0.22
 *   cols 7-12 (right half, left->right): P0.02 P1.15 P1.13 P1.11 P0.10 P0.09
 *   rows 1-5  (top->bottom):             P1.07 P1.02 P1.01 P0.29 P0.31
 *   free for the nice!view:              P0.06 (CS)  P0.17 (MOSI)  P0.20 (SCK)
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        // 56 keys in physical order (verified with the matrix test, 2026-10-11).
        // Unused matrix slots: RC(0,0) RC(0,11) RC(4,0) RC(4,11).
        //
        //        C2   C3   C4   C5   C6        C7   C8   C9   C10  C11            <- top row (no C1/C12)
        //   C1   C2   C3   C4   C5   C6        C7   C8   C9   C10  C11  C12
        //   C1   C2   C3   C4   C5   C6        C7   C8   C9   C10  C11  C12
        //   C1   C2   C3   C4   C5   C6        C7   C8   C9   C10  C11  C12
        //             C3   C4                            C9   C10                <- bottom row
        //              thumbs L: outer R5C5, mid R5C6, inner R5C2
        //              thumbs R: inner R5C11, mid R5C7, outer R5C8
        map = <
        RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                RC(4,2) RC(4,3)                                   RC(4,8) RC(4,9)
                        RC(4,4) RC(4,5) RC(4,1)   RC(4,10) RC(4,6) RC(4,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio1  7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* R1 P1.07 (middle pad) */
            , <&gpio1  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* R2 P1.02 (middle pad) */
            , <&gpio1  1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* R3 P1.01 (middle pad) */
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* R4 P0.29 */
            , <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* R5 P0.31 */
            ;

        col-gpios
            = <&gpio1  6 GPIO_ACTIVE_HIGH>   /* C1  P1.06 */
            , <&gpio1  4 GPIO_ACTIVE_HIGH>   /* C2  P1.04 */
            , <&gpio0 11 GPIO_ACTIVE_HIGH>   /* C3  P0.11 */
            , <&gpio1  0 GPIO_ACTIVE_HIGH>   /* C4  P1.00 */
            , <&gpio0 24 GPIO_ACTIVE_HIGH>   /* C5  P0.24 */
            , <&gpio0 22 GPIO_ACTIVE_HIGH>   /* C6  P0.22 */
            , <&gpio0  2 GPIO_ACTIVE_HIGH>   /* C7  P0.02 */
            , <&gpio1 15 GPIO_ACTIVE_HIGH>   /* C8  P1.15 */
            , <&gpio1 13 GPIO_ACTIVE_HIGH>   /* C9  P1.13 */
            , <&gpio1 11 GPIO_ACTIVE_HIGH>   /* C10 P1.11 */
            , <&gpio0 10 GPIO_ACTIVE_HIGH>   /* C11 P0.10 (NFC pin, used as GPIO) */
            , <&gpio0  9 GPIO_ACTIVE_HIGH>   /* C12 P0.09 (NFC pin, used as GPIO) */
            ;
    };
};
